<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>FORM P.Temp</title>

    <!-- You can keep or remove these if you already include them globally -->
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", Arial, sans-serif;
        font-size: 11px;
        color: #000;
      }

      /* A4-ish page container so print-to-PDF looks like the original */
      .page {
        width: 794px;              /* ~A4 width at 96dpi */
        min-height: 1123px;        /* ~A4 height */
        margin: 0 auto;
        padding: 36px 48px;
      }

      .printing-date {
        text-align: right;
        font-size: 10px;
        margin-bottom: 6px;
      }

      .header-row {
        display: table;
        width: 100%;
        margin-bottom: 10px;
      }

      .header-cell {
        display: table-cell;
        vertical-align: top;
      }

      .header-logo {
        width: 22%;
      }

      .header-logo img {
        width: 80px;
        height: auto;
      }

      .header-center {
        width: 56%;
        text-align: center;
        line-height: 1.4;
      }

      .header-center .gov {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .header-center .form {
        font-size: 12px;
        font-weight: 600;
      }

      .header-center .rule {
        font-size: 10px;
        margin-top: 2px;
      }

      .header-center .auth {
        font-size: 12px;
        font-weight: 600;
        margin-top: 2px;
      }

      .header-qr {
        width: 22%;
        text-align: right;
      }

      .header-qr img {
        width: 70px;
        height: 70px;
        display: block;
        margin-left: auto;
        margin-bottom: 4px;
      }

      table.kv {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 6px;
      }

      table.kv td {
        padding: 2px 2px;
        vertical-align: top;
      }

      table.kv td.label {
        width: 18%;
        white-space: nowrap;
      }

      table.kv td.value {
        width: 32%;
        font-weight: 600;
      }

      .body-text {
        margin-top: 4px;
        font-size: 10.5px;
        text-align: justify;
      }

      table.mini {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 10.5px;
      }

      table.mini td {
        padding: 2px 2px;
        vertical-align: top;
      }

      table.mini td.label {
        width: 18%;
        white-space: nowrap;
      }

      table.mini td.value {
        width: 32%;
        font-weight: 600;
      }

      .small-text {
        margin-top: 4px;
        font-size: 10px;
        text-align: justify;
      }

      table.tax {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 10.5px;
      }

      table.tax th,
      table.tax td {
        border: 1px solid #000;
        padding: 3px 5px;
      }

      table.tax th {
        text-align: center;
        font-weight: 700;
      }

      table.tax td.num {
        text-align: right;
        width: 12%;
      }

      .grand-total {
        margin-top: 6px;
        font-size: 11px;
        font-weight: 700;
      }

      .terms {
        margin-top: 10px;
        font-size: 9.5px;
      }

      .terms-title {
        font-weight: 700;
        margin-bottom: 2px;
      }

      .terms ol {
        margin: 0 0 0 18px;
        padding: 0;
      }

      .terms li {
        margin-bottom: 2px;
      }

      .note {
        margin-top: 6px;
        font-size: 9.5px;
      }

      .note a {
        color: #0000ee;
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <div class="page">
      <% if (data.receiptPrintingDate) { %>
        <div class="printing-date">
          Receipt Printing Date:
          <br />
          <%= data.receiptPrintingDate %>
        </div>
      <% } %>

      <!-- Header: Logo - Title - QR -->
      <div class="header-row">
        <div class="header-cell header-logo">
          <img src="/images1/Puducherry.png" alt="Logo" />
        </div>

        <div class="header-cell header-center">
          <div class="gov">GOVERNMENT OF PUDUCHERRY</div>
          <div class="form">FORM P.Temp</div>
          <div class="rule">[See rule 61(1)(iv)]</div>
          <div class="auth">THE STATE TRANSPORT AUTHORITY, PUDUCHERRY</div>
        </div>

        <div class="header-cell header-qr">
          <% if (data.qrLeft) { %>
            <img src="<%= data.qrLeft %>" alt="QR Left" />
          <% } %>
          <% if (data.qrRight) { %>
            <img src="<%= data.qrRight %>" alt="QR Right" />
          <% } %>
        </div>
      </div>

      <!-- Main key-value table -->
      <table class="kv">
        <tr>
          <td class="label">Registration No.</td>
          <td class="value">: <%= data.vehicleNo %></td>
          <td class="label">Receipt No.</td>
          <td class="value">: <%= data.receiptNo %></td>
        </tr>
        <tr>
          <td class="label">Payment Date</td>
          <td class="value">: <%= data.paymentDate %></td>
          <td class="label">Owner Name</td>
          <td class="value">: <%= data.ownerName %></td>
        </tr>
        <tr>
          <td class="label">Chassis No.</td>
          <td class="value">: <%= data.chassisNo %></td>
          <td class="label">Tax Mode</td>
          <td class="value">: <%= data.taxMode %></td>
        </tr>
        <tr>
          <td class="label">Vehicle Type</td>
          <td class="value">: <%= data.vehicleType %></td>
          <td class="label">Vehicle Class</td>
          <td class="value">: <%= data.vehicleClass %></td>
        </tr>
        <tr>
          <td class="label">Vehicle Category</td>
          <td class="value">: <%= data.vehicleCategory %></td>
          <td class="label">Mobile No.</td>
          <td class="value">: <%= data.mobileNo %></td>
        </tr>
        <tr>
          <td class="label">Checkpost Name</td>
          <td class="value">: <%= data.checkPostName %></td>
          <td class="label">Seating Capacity</td>
          <td class="value">: <%= data.seatingCapacity %></td>
        </tr>
        <tr>
          <td class="label">Sleeper Cap.</td>
          <td class="value">: <%= data.sleeperCap %></td>
          <td class="label">Payment Mode</td>
          <td class="value">: <%= data.paymentMode %></td>
        </tr>
      </table>

      <div class="body-text">
        This permit shall be subject to all rules relating to Permits made under the Motor Vehicles Act, 1988 and in
        force for the time being.
      </div>

      <!-- Secondary info table -->
      <table class="mini">
        <tr>
          <td class="label">Bank Ref. No.</td>
          <td class="value">: <%= data.bankRefNo %></td>
          <td class="label">Permit Validity</td>
          <td class="value">: <%= data.permitValidity %></td>
        </tr>
        <tr>
          <td class="label">Fitness Validity</td>
          <td class="value">: <%= data.fitnessValidity %></td>
          <td class="label">Insurance Validity</td>
          <td class="value">: <%= data.insuranceValidity %></td>
        </tr>
        <tr>
          <td class="label">Service Type</td>
          <td class="value">: <%= data.serviceType %></td>
          <td class="label">Permit Type</td>
          <td class="value">: <%= data.permitType %></td>
        </tr>
      </table>

      <div class="small-text">
        Under the provision of sub-section (4) of section 89 of Act and with the particular consent of the Transport
        Authority concerned, this Permit is valid for <strong><%= data.validDays %></strong> days only.
      </div>

      <!-- Tax table -->
      <table class="tax">
        <thead>
          <tr>
            <th>Tax/Fee Particular</th>
            <th>Tax/Fees</th>
            <th>Fine</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              MV Tax ( <%= data.mvTaxFrom %> TO <%= data.mvTaxTo %> )
            </td>
            <td class="num"><%= data.mvTaxAmount %></td>
            <td class="num"><%= data.mvTaxFine %></td>
            <td class="num"><%= data.mvTaxTotal %></td>
          </tr>
          <tr>
            <td>
              Service/User Charge ( <%= data.serviceFrom %> TO <%= data.serviceTo %> )
            </td>
            <td class="num"><%= data.serviceAmount %></td>
            <td class="num"><%= data.serviceFine %></td>
            <td class="num"><%= data.serviceTotal %></td>
          </tr>
        </tbody>
      </table>

      <div class="grand-total">
        Grand Total : <%= data.grandTotal %>/- <%= data.grandTotalWords %> ONLY
      </div>

      <div class="terms">
        <div class="terms-title">Terms and Conditions:</div>
        <ol>
          <li>This is a computer generated printout and no signature is required.</li>
          <li>
            Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and defaulter shall be
            liable for penal action.
          </li>
        </ol>
      </div>

      <div class="note">
        Note : This document is generated from testing server and has no legal or official value.
        <br />
        Scan the QR code for genuinity of the receipt, it should land at
        <a href="https://kms.parivahan.gov.in">https://kms.parivahan.gov.in</a>. If the URL is different, the receipt
        could be fake, please raise a complaint.
      </div>
    </div>
  </body>
</html>
