<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Puducherry - Tax Receipt</title>

  <link rel="stylesheet" href="<%= data.host %>/css/style.css" />
  <link rel="stylesheet" href="<%= data.host %>/css/page.css" />

  <style>
    * { box-sizing: border-box; }
    @page { size: A4; margin: 0; }

    body{
      margin:0; padding:0; background:#fff;
      font-family: "Times New Roman", Times, serif;
      color:#000;
      font-size: 12px;
      line-height: 1.25;
      font-weight: bold; /* ✅ make everything bold */
    }

    .main{
      width:210mm;
      margin:0 auto;
      padding: 12mm 15mm;
      position:relative;
    }

    .content{ position:relative; z-index: 2; }

    /* ✅ watermark MORE smaller */
    .watermark{
      position:absolute;
      top: 52%;
      left: 50%;
      transform: translate(-50%,-50%);
      width: 250px;           /* ✅ smaller than before */
      opacity: 0.15;
      z-index: 1;
      pointer-events:none;
    }

    /* HEADER */
    .header{
      display: table;
      width: 100%;
      margin-bottom: 10px;
    }
    .header-cell{
      display: table-cell;
      vertical-align: top;
    }
    .header-logo{ width: 22%; }
    .header-logo img{ width: 85px; height:auto; }

    .header-center{
      width: 56%;
      text-align:center;
      line-height: 1.25;
    }
    .header-center .gov{
      font-size: 14px;
      font-weight: bold;
      text-transform: uppercase;
    }
    .header-center .form{
      font-size: 12px;
      font-weight: bold;
      margin-top: 2px;
    }
    .header-center .rule{
      font-size: 11px;
      margin-top: 1px;
      font-weight: bold;
    }
    .header-center .auth{
      font-size: 12px;
      font-weight: bold;
      margin-top: 2px;
      text-transform: uppercase;
    }

    .header-qr{ width: 22%; text-align: right; }
    .header-qr img{ width: 115px; height:115px; object-fit:contain; }

    /* MAIN KV TABLE */
    table.kv{
      width:100%;
      border-collapse: collapse;
      table-layout: fixed;
      margin-bottom: 6px;
      font-size: 12px;
    }
    table.kv td{
      padding: 2px 2px;
      vertical-align: top;
      font-weight: bold; /* ✅ label + value bold */
    }
    table.kv td.label{
      white-space: nowrap;
      font-weight: bold;
    }
    table.kv td.value{
      font-weight: bold;
      padding-left: 2px;
      white-space: normal;
    }

    .body-text{
      margin-top: 4px;
      font-size: 12px;
      text-align: justify;
      font-weight: bold;
    }

    /* ✅ mini table font size equal to kv */
    table.mini{
      width:100%;
      border-collapse: collapse;
      margin-top: 6px;
      font-size: 12px;  /* ✅ increased */
      font-weight: bold;
    }
    table.mini td{ padding: 2px 2px; vertical-align: top; font-weight:bold; }
    table.mini td.label{ width: 20%; white-space: nowrap; font-weight:bold; }
    table.mini td.value{ width: 30%; font-weight: bold; }

    .small-text{
      margin-top: 6px;
      font-size: 12px;
      text-align: justify;
      font-weight: bold;
    }

    table.tax{
      width: 100%;
      border-collapse: collapse;
      margin-top: 14px;
      font-size: 11px;
    }
    table.tax th, table.tax td{
      border: 1px solid #6aa5ff;
      padding: 4px 6px;
      font-weight: bold;
    }
    table.tax th{
      text-align:center;
      font-weight:bold;
    }
    table.tax td.num{ text-align:right; width: 12%; }

    .grand-total{
      margin-top: 6px;
      font-size: 11px;
      font-weight: bold;
    }

    .note-small{ margin-top: 6px; font-size: 10px; font-weight: bold; }
    .terms-title{ font-weight: bold; margin-top: 4px; margin-bottom: 2px; }
    .terms-list{ margin: 0 0 0 16px; padding: 0; }
    .terms-list li{ margin-bottom: 2px; font-weight: bold; }

    .bottom-note-url{
      font-size: 14px;
      font-weight: bold;
      margin-top: 6px;
    }
    .bottom-note-url a{
      color: #0b5bd3;
      text-decoration: underline;
      font-weight: bold;
    }
  </style>
</head>

<body>
<%
  const pad2 = (n) => String(n).padStart(2,'0');

  const safeDate = (v) => {
    if (!v) return '';
    const s = String(v).trim();
    if (!s || s === 'INVALID-DATE' || s === 'Invalid Date') return '';
    const d = new Date(s);
    if (isNaN(d.getTime())) return '';
    return `${pad2(d.getDate())}-${pad2(d.getMonth()+1)}-${d.getFullYear()}`;
  };

  const safeDateTime = (v) => {
    if (!v) return '';
    const s = String(v).trim();
    if (!s || s === 'INVALID-DATE' || s === 'Invalid Date') return '';
    const d = new Date(s);
    if (isNaN(d.getTime())) return '';
    const hh = d.getHours() % 12 || 12;
    const mm = pad2(d.getMinutes());
    const ampm = d.getHours() >= 12 ? 'PM' : 'AM';
    return `${pad2(d.getDate())}-${(d.toLocaleString('en-US',{month:'short'})).toUpperCase()}-${d.getFullYear()} ${hh}:${mm} ${ampm}`;
  };

  // ✅ Sleeper cap fallback to 0 if missing/blank
  const sleeperValRaw = (data.sleeperCap ?? data.sleeperCapacityExcludingDriver ?? '');
  const sleeperVal = (sleeperValRaw === '' || sleeperValRaw === null || sleeperValRaw === undefined)
    ? '0'
    : String(sleeperValRaw);

  const permitValidityVal =
    safeDate(data.permitUpto) ||
    safeDate(data.permitValidity) ||
    safeDate(data.permitValidUpto) ||
    '';

  const paymentDateVal =
    safeDateTime(data.paymentDate) ||
    safeDateTime(data.receiptDate) ||
    safeDateTime(Date.now());

  const districtVal = data.borderBarrier || data.districtName || data.district || '';
  const checkpostVal = data.checkpostName || data.checkPostName || '';

  const bankRefStatic = "IK0DLTDUU5"; /* ✅ STATIC as you asked */
%>

<div class="main">
  <img src="<%= data.host %>/images1/Pudu.png" class="watermark" alt="Watermark" />

  <div class="content">
    <!-- HEADER -->
    <div class="header">
      <div class="header-cell header-logo">
        <img src="<%= data.logoSrc || (data.host + '/images1/Pudu.png') %>" alt="Logo" />
      </div>

      <div class="header-cell header-center">
        <div class="gov">GOVERNMENT OF PUDUCHERRY</div>
        <div class="form">FORM P.Temp</div>
        <div class="rule">[See rule 61(1)(iv)]</div>
        <div class="auth">THE STATE TRANSPORT AUTHORITY, PUDUCHERRY</div>
      </div>

      <div class="header-cell header-qr">
        <% if (data.src) { %>
          <img src="<%= data.src %>" alt="QR Code" />
        <% } %>
      </div>
    </div>

    <!-- MAIN DETAILS -->
    <table class="kv">
      <colgroup>
        <col style="width:22%">
        <col style="width:28%">
        <col style="width:22%">
        <col style="width:28%">
      </colgroup>

      <tr>
        <td class="label">Registration No.</td>
        <td class="value">: <%= data.vehicleNo || '' %></td>
        <td class="label">Receipt No.</td>
        <td class="value">: <%= data.receiptNo || '' %></td>
      </tr>

      <tr>
        <td class="label">Payment Date</td>
        <td class="value">: <%= paymentDateVal %></td>
        <td class="label">Owner Name.</td>
        <td class="value">: <%= data.ownerName || '' %></td>
      </tr>

      <tr>
        <td class="label">Chassis No.</td>
        <td class="value">: <%= data.chassisNo || '' %></td>
        <td class="label">TaxMode</td>
        <td class="value">: <%= data.taxMode || '' %></td>
      </tr>

      <tr>
        <td class="label">Vehicle Type</td>
        <td class="value">: <%= data.vehiclePermitType || '' %></td>
        <td class="label">Vehicle Class</td>
        <td class="value">: <%= data.vehicleClass || '' %></td>
      </tr>

      <!-- ✅ Vehicle Category removed -->
      <tr>
        <td class="label">Mobile No.</td>
        <td class="value">: <%= data.mobileNo || '' %></td>
        <td class="label"></td>
        <td class="value"></td>
      </tr>

      <tr>
        <td class="label">District</td>
        <td class="value">: <%= districtVal %></td>
        <td class="label">CheckPost Name</td>
        <td class="value">: <%= checkpostVal %></td>
      </tr>

      <tr>
        <td class="label">Seating Capacity</td>
        <td class="value">: <%= data.seatingCapacityExcludingDriver || data.seatingCapacity || '' %></td>
        <td class="label">Sleeper Cap</td>
        <td class="value">: <%= sleeperVal %></td>
      </tr>

      <tr>
        <td class="label">Payment Mode</td>
        <td class="value">: <%= data.paymentMode || 'ONLINE' %></td>
        <td class="label"></td>
        <td class="value"></td>
      </tr>
    </table>

    <div class="body-text">
      This permit shall be subject to all rules relating to Permits made under the Motor Vehicles Act, 1988 and in force for the time being.
    </div>

    <!-- SECONDARY DETAILS -->
    <table class="mini">
      <tr>
        <td class="label">Bank Ref. No.</td>
        <td class="value">: <%= bankRefStatic %></td>
        <td class="label">Permit Validity</td>
        <td class="value">: <%= permitValidityVal %></td>
      </tr>

      <tr>
        <td class="label">Fitness Validity</td>
        <td class="value">: <%= safeDate(data.fitnessValidity) || data.fitnessValidity || '' %></td>
        <td class="label">Insurance Validity</td>
        <td class="value">: <%= safeDate(data.insuranceValidity) || data.insuranceValidity || '' %></td>
      </tr>

      <tr>
        <td class="label">Service Type</td>
        <td class="value">: <%= data.serviceType || '' %></td>
        <td class="label">Permit Type</td>
        <td class="value">: <%= data.permitType || '' %></td>
      </tr>
    </table>

    <div class="small-text">
      Under the provision of sub-section(4) of section 89 of Act and with the particular consent of the Transport Authority concerned.
      This Permit is valid for -- <%= data.validDays || data.permitValidDays || data.noOfDays || '' %> Days only.
    </div>

    <%
      const toNumber = (v) => { const n = Number(v); return isNaN(n) ? 0 : n; };

      const mvTaxFrom = data.mvTaxFrom || data.taxFrom_up || data.taxFrom || '';
      const mvTaxTo = data.mvTaxTo || data.taxTo_up || data.taxTo || '';

      const mvAmount = toNumber((data.mvTaxAmount != null && data.mvTaxAmount !== '') ? data.mvTaxAmount : data.totalAmount);
      const mvFine = toNumber(data.mvTaxFine);
      const mvTotal = (data.mvTaxTotal != null && data.mvTaxTotal !== '') ? toNumber(data.mvTaxTotal) : mvAmount + mvFine;

      const svcFrom = data.serviceFrom || mvTaxFrom;
      const svcTo = data.serviceTo || mvTaxTo;

      const svcAmount = toNumber(data.serviceAmount || data.serviceUserChargeAmount);
      const svcFine = toNumber(data.serviceFine);
      const svcTotal = (data.serviceTotal != null && data.serviceTotal !== '') ? toNumber(data.serviceTotal) : svcAmount + svcFine;

      const grandTotal = (data.grandTotal != null && data.grandTotal !== '') ? toNumber(data.grandTotal) : mvTotal + svcTotal;
      const grandWords = data.grandTotalWords || data.totalAmountInWord || '';
    %>

    <!-- TAX TABLE -->
    <table class="tax">
      <thead>
        <tr>
          <th>Tax/Fee Particular</th>
          <th>Tax/Fees</th>
          <th>Fine</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>MV Tax ( <%= mvTaxFrom %> To <%= mvTaxTo %> )</td>
          <td class="num"><%= mvAmount %></td>
          <td class="num"><%= mvFine %></td>
          <td class="num"><%= mvTotal %></td>
        </tr>
        <tr>
          <td>Service/User Charge ( <%= svcFrom %> To <%= svcTo %> )</td>
          <td class="num"><%= svcAmount %></td>
          <td class="num"><%= svcFine %></td>
          <td class="num"><%= svcTotal %></td>
        </tr>
      </tbody>
    </table>

    <div class="grand-total">
      Grand Total : <%= grandTotal %>/- <%= grandWords %> Only
    </div>

    <div class="note-small"><b>Note :</b></div>

    <div class="note-small">
      <span class="terms-title">Terms and Conditions:</span>
      <ol class="terms-list">
        <li>This is a computer generated printout and no signature is required.</li>
        <li>Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and defaulter shall be liable for penal action.</li>
      </ol>
    </div>

    <div class="bottom-note-url">
      Scan the QR code for genuinity of the receipt, It should land at
      <a href="https://kms.parivahan.gov.in">https://kms.parivahan.gov.in</a>
      site. In case the URL is different, then receipt could be a fake one, please raise a complain.
    </div>
  </div>
</div>
</body>
</html>
