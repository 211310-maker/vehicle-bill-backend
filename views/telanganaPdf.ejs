<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Telangana - Checkpost Tax e-Receipt</title>

    <style>
      * { box-sizing: border-box; }
      @page { size: A4; margin: 0; }

      body {
        margin: 0;
        padding: 0;
        background: #fff;
        font-family: Arial, Helvetica, sans-serif;
        color: #000;
      }

      .page {
        width: 210mm;
        height: 297mm;
        padding: 14mm 16mm;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
      }

      .bg-text {
        position: absolute;
        margin: 0 auto;
        max-width: 205mm;
        inset: 0;
        opacity: 0.30;
        padding: 10mm 18mm 90mm 13mm;
        color: #6b6b6b;
        font-size: 14px;
        line-height: 1.55;
        z-index: 0;
        pointer-events: none;
      }
      .bg-text .row {
        white-space: nowrap;
        overflow: hidden;
      }

      .bg-emblem {
        position: absolute;
        left: 55%;
        top: 25%;
        transform: translate(-50%, -50%);
        width: 210px;
        height: 210px;
        opacity: 0.40;
        z-index: 1;
        pointer-events: none;
      }

      .content {
        position: relative;
        z-index: 2;
      }

      .top {
        display: grid;
        grid-template-columns: 90px 1fr 130px;
        align-items: start;
        column-gap: 10px;
        margin-bottom: 8px;
      }

      .top .logo {
        width: 90px;
        height: 90px;
        object-fit: contain;
        position: relative;
        left: 35px;
        top: 10px;
      }

      .top .qr {
        width: 130px;
        height: 130px;
        object-fit: contain;
        justify-self: end;
        position: relative;
        left: -55px;
        top: 7px;
      }

      .title {
        text-align: center;
        margin-top: 30px;
        line-height: 1.25;
      }

      .title .t1 { font-weight: 700; font-size: 12px; text-transform: uppercase; text-decoration: underline; }
      .title .t2 { font-weight: 700; font-size: 12px; margin-top: 2px; }
      .title .t3 { font-weight: 700; font-size: 11px; margin-top: 2px; }

      .kv-wrap {
        margin-top: 6px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 28px;
        row-gap: 8px;
      }

      table.kv {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 12px;
      }

      table.kv td {
        padding: 4px 0;
        vertical-align: top;
      }

      table.kv td.label {
        width: 42%;
        white-space: nowrap;
        font-weight: 600;
      }

      table.kv td.colon {
        width: 4%;
        text-align: center;
        font-weight: 600;
      }

      table.kv td.value {
        width: 54%;
        font-weight: 700;
        word-break: break-word;
      }

      .tax-table {
        margin-top: 18px;
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 11px;
      }

      .tax-table th, .tax-table td {
        border: 1px solid #6fa8ff;
        padding: 6px 8px;
      }

      .tax-table th {
        text-align: center;
        font-weight: 700;
      }

      .tax-table td.part {
        font-weight: 700;
      }

      .tax-table td.num {
        text-align: center;
        font-weight: 700;
        white-space: nowrap;
      }

      .grand {
        margin-top: 10px;
        font-size: 11px;
        font-weight: 700;
      }

      .section {
        margin-top: 8px;
        font-size: 11px;
      }

      .section .hdr {
        font-weight: 700;
        margin-bottom: 4px;
      }

      .section ol {
        margin: 0;
        padding-left: 18px;
      }

      .footer-bold {
        margin-top: 12px;
        font-size: 18px;
        font-weight: 800;
      }
    </style>
  </head>

  <body>
    <%
      const safe = (v) => (v === null || v === undefined) ? "" : String(v);

      const pick = (...vals) => {
        for (const v of vals) {
          if (v === null || v === undefined) continue;
          if (typeof v === "string" && v.trim() === "") continue;
          return v;
        }
        return "";
      };

      const toNum = (v) => {
        const n = Number(v);
        return Number.isFinite(n) ? n : 0;
      };

      const bgLine = `${safe(pick(data.vehicleNo))} ${safe(pick(data.receiptDate, data.paymentDate, data.upPaymentDate))}`.trim();

      const seatingCap = pick(data.seatingCapacityExcludingDriver, data.seatingCapacity, data.seatCapacity);
      const sleeperCap = pick(data.sleeperCapacityExcludingDriver, data.sleeperCapacity, data.sleeperCap);

      const grossVehicleWeight = pick(
        data.grossVehicleWeight,
        data.grossVehicleWeightInKg,
        data.grossVehicleWeightKg
      );

      const unladenWeight = pick(
        data.unladenWeight,
        data.unladenWeightInKg,
        data.unladenWeightKg
      );

      const hasWeightData = grossVehicleWeight !== "" || unladenWeight !== "";

      const vehicleType = pick(data.vehicleType, data.vehiclePermitType);
      const checkpost   = pick(data.checkpostName, data.checkPostName, data.borderBarrier);
    %>

    <div class="page">
      <div class="bg-text" aria-hidden="true">
        <% for (let i = 0; i < 26; i++) { %>
          <div class="row"><%= bgLine %>&nbsp;&nbsp;<%= bgLine %></div>
        <% } %>
      </div>

      <img class="bg-emblem" src="/images1/Telangana.png" alt="" />

      <div class="content">
        <div class="top">
          <img class="logo" src="/images1/Telangana.png" alt="Telangana Logo" />

          <div class="title">
            <div class="t1">GOVERNMENT OF TELANGANA</div>
            <div class="t2">Department of Transport</div>
            <div class="t3">Checkpost Tax e-Receipt(Single Journey)</div>
          </div>

          <% if (data.src) { %>
            <img class="qr" src="<%= data.src %>" alt="QR Code" />
          <% } else { %><div></div><% } %>
        </div>

        <div class="kv-wrap">
          <table class="kv">
            <tr><td class="label">Registration No.</td><td class="colon">:</td><td class="value"><%= safe(data.vehicleNo) %></td></tr>
            <tr><td class="label">Owner Name</td><td class="colon">:</td><td class="value"><%= safe(data.ownerName) %></td></tr>
            <tr><td class="label">Tax Mode</td><td class="colon">:</td><td class="value"><%= safe(data.taxMode) %></td></tr>
            <tr><td class="label">Vehicle Class</td><td class="colon">:</td><td class="value"><%= safe(data.vehicleClass) %></td></tr>
            <tr><td class="label">Mobile No.</td><td class="colon">:</td><td class="value"><%= safe(data.mobileNo) %></td></tr>

            <% if (hasWeightData) { %>
              <tr><td class="label">Gross Vehicle Weight (in Kg)*</td><td class="colon">:</td><td class="value"><%= safe(grossVehicleWeight) %></td></tr>
            <% } else { %>
              <tr><td class="label">Seating Capacity</td><td class="colon">:</td><td class="value"><%= safe(seatingCap) %></td></tr>
            <% } %>

            <tr><td class="label">Bank Ref. No.</td><td class="colon">:</td><td class="value"><%= safe(pick(data.upBankRefNo, data.bankRefNo)) %></td></tr>
            <tr><td class="label">Permit Validity</td><td class="colon">:</td><td class="value"><%= safe(data.permitValidity) %></td></tr>
            <tr><td class="label">Permit Type</td><td class="colon">:</td><td class="value"><%= safe(data.permitType) %></td></tr>
          </table>

          <table class="kv">
            <tr><td class="label">Receipt No.</td><td class="colon">:</td><td class="value"><%= safe(data.receiptNo) %></td></tr>
            <tr><td class="label">Chassis No.</td><td class="colon">:</td><td class="value"><%= safe(data.chassisNo) %></td></tr>
            <tr><td class="label">Vehicle Type</td><td class="colon">:</td><td class="value"><%= safe(vehicleType) %></td></tr>
            <tr><td class="label">Vehicle Category</td><td class="colon">:</td><td class="value"><%= safe(data.vehicleCategory) %></td></tr>
            <tr><td class="label">CheckPost Name</td><td class="colon">:</td><td class="value"><%= safe(checkpost) %></td></tr>

            <% if (hasWeightData) { %>
              <tr><td class="label">Unladen Weight (in Kg)</td><td class="colon">:</td><td class="value"><%= safe(unladenWeight) %></td></tr>
            <% } else { %>
              <tr><td class="label">Sleeper Cap</td><td class="colon">:</td><td class="value"><%= safe(sleeperCap) %></td></tr>
            <% } %>

            <tr><td class="label">Payment Mode</td><td class="colon">:</td><td class="value"><%= safe(data.paymentMode) %></td></tr>
            <tr><td class="label">Service Type</td><td class="colon">:</td><td class="value"><%= safe(data.serviceType) %></td></tr>
            <tr><td class="label">Route</td><td class="colon">:</td><td class="value"><%= safe(data.route) %></td></tr>
          </table>
        </div>

        <div class="footer-bold">Scan the QR code for genuinity of the receipt.</div>
      </div>
    </div>
  </body>
</html>
