<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Telangana - Checkpost Tax e-Receipt</title>

<style>
*{box-sizing:border-box}
@page{size:A4;margin:0}

body{
  margin:0;
  background:#fff;
  font-family: Arial, Helvetica, sans-serif;
  color:#000;
}

.page{
  width:210mm;
  height:297mm;
  padding:14mm 16mm;
  position:relative;
  overflow:hidden;
}

/* ================= BACKGROUND TEXT ================= */
.bg-text{
  position:absolute;
  inset:0;
  padding:18mm 16mm;
  font-size:10px;
  line-height:1.5;
  color:#777;
  opacity:.18;
  z-index:0;
  pointer-events:none;
}
.bg-text .row{
  white-space:nowrap;
}

/* ================= WATERMARK ================= */
.bg-emblem{
  position:absolute;
  left:50%;
  top:38%;
  transform:translate(-50%,-50%);
  width:135px;
  height:135px;
  opacity:.16;
  z-index:0;
  pointer-events:none;
}

/* ================= CONTENT ================= */
.content{position:relative;z-index:1}

/* ================= HEADER ================= */
.top{
  display:grid;
  grid-template-columns:70px 1fr 110px;
  align-items:start;
  column-gap:8px;
}

.top .logo{
  width:70px;
  height:70px;
  object-fit:contain;
}

.top .qr{
  width:110px;
  height:110px;
  object-fit:contain;
  justify-self:end;
}

.title{
  text-align:center;
  margin-top:6px;
  line-height:1.2;
}

.title .t1{
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  text-decoration:underline;
}
.title .t2{
  font-size:11px;
  font-weight:700;
  margin-top:2px;
}
.title .t3{
  font-size:10px;
  font-weight:700;
  margin-top:2px;
}

/* ================= DETAILS ================= */
.kv-wrap{
  margin-top:6px;
  display:grid;
  grid-template-columns:1fr 1fr;
  column-gap:26px;
  row-gap:6px;
}

table.kv{
  width:100%;
  border-collapse:collapse;
  table-layout:fixed;
  font-size:11px;
}

table.kv td{
  padding:1.5px 0;
  vertical-align:top;
}

td.label{
  width:42%;
  font-weight:600;
  white-space:nowrap;
}
td.colon{
  width:4%;
  text-align:center;
  font-weight:600;
}
td.value{
  width:54%;
  font-weight:700;
  word-break:break-word;
}

/* ================= TAX TABLE ================= */
.tax-table{
  margin-top:16px;
  width:100%;
  border-collapse:collapse;
  table-layout:fixed;
  font-size:11px;
}

.tax-table th,
.tax-table td{
  border:1px solid #6fa8ff;
  padding:6px 8px;
}

.tax-table th{
  text-align:center;
  font-weight:700;
}

.tax-table td.part{font-weight:700}
.tax-table td.num{
  text-align:center;
  font-weight:700;
}

/* ================= FOOTER ================= */
.grand{
  margin-top:8px;
  font-size:11px;
  font-weight:700;
}

.section{
  margin-top:6px;
  font-size:11px;
}

.section .hdr{
  font-weight:700;
  margin-bottom:2px;
}

.section ol{
  margin:0;
  padding-left:16px;
}

.footer-bold{
  margin-top:10px;
  font-size:16px;
  font-weight:800;
}
</style>
</head>

<body>

<%
  const safe = (v) => (v === null || v === undefined) ? "" : String(v);
  const pick = (...vals) => {
    for (const v of vals) {
      if (v === null || v === undefined) continue;
      if (typeof v === "string" && v.trim() === "") continue;
      return v;
    }
    return "";
  };
  const toNum = (v) => Number.isFinite(Number(v)) ? Number(v) : 0;

  const bgLine = `${safe(pick(data.vehicleNo))} ${safe(pick(data.paymentDate,data.receiptDate))}`;

  const taxFrom = pick(data.taxFrom,data.taxFromDate);
  const taxTo   = pick(data.taxTo,data.taxUptoDate);

  const rows = [
    data.mvTax && {
      particular:`MV Tax (${taxFrom} To ${taxTo})`,
      tax:data.mvTax,fine:0,total:data.mvTax
    },
    data.userCharge && {
      particular:`Service/User Charge (${taxFrom} To ${taxTo})`,
      tax:data.userCharge,fine:0,total:data.userCharge
    },
    data.taxTokenFee && {
      particular:`Tax Token Fee (${taxFrom} To ${taxTo})`,
      tax:data.taxTokenFee,fine:0,total:data.taxTokenFee
    }
  ].filter(Boolean);

  const grandTotal = rows.reduce((s,r)=>s+toNum(r.total),0);
%>

<div class="page">

  <!-- BACKGROUND -->
  <div class="bg-text">
    <% for(let i=0;i<26;i++){ %>
      <div class="row">
        <%= bgLine %>&nbsp;&nbsp;&nbsp;&nbsp;<%= bgLine %>&nbsp;&nbsp;&nbsp;&nbsp;<%= bgLine %>
      </div>
    <% } %>
  </div>

  <img class="bg-emblem" src="/images1/Telangana.png" />

  <div class="content">

    <!-- HEADER -->
    <div class="top">
      <img class="logo" src="/images1/Telangana.png" />

      <div class="title">
        <div class="t1">GOVERNMENT OF TELANGANA</div>
        <div class="t2">Department of Transport</div>
        <div class="t3">Checkpost Tax e-Receipt (Single Journey)</div>
      </div>

      <img class="qr" src="<%= data.src %>" />
    </div>

    <!-- DETAILS -->
    <div class="kv-wrap">

      <table class="kv">
        <tr><td class="label">Registration No.</td><td class="colon">:</td><td class="value"><%= data.vehicleNo %></td></tr>
        <tr><td class="label">Owner Name</td><td class="colon">:</td><td class="value"><%= data.ownerName %></td></tr>
        <tr><td class="label">Tax Mode</td><td class="colon">:</td><td class="value"><%= data.taxMode %></td></tr>
        <tr><td class="label">Vehicle Class</td><td class="colon">:</td><td class="value"><%= data.vehicleClass %></td></tr>
        <tr><td class="label">Mobile No.</td><td class="colon">:</td><td class="value"><%= data.mobileNo %></td></tr>
        <tr><td class="label">Seating Capacity</td><td class="colon">:</td><td class="value"><%= data.seatingCapacity %></td></tr>
        <tr><td class="label">Bank Ref. No.</td><td class="colon">:</td><td class="value"><%= data.bankRefNo %></td></tr>
        <tr><td class="label">Permit Validity</td><td class="colon">:</td><td class="value"><%= data.permitValidity %></td></tr>
        <tr><td class="label">Permit Type</td><td class="colon">:</td><td class="value"><%= data.permitType %></td></tr>
        <tr><td class="label">Gross Combination<br>Weight(in kg.)</td><td class="colon">:</td><td class="value"><%= data.grossVehicleWeight %></td></tr>
      </table>

      <table class="kv">
        <tr><td class="label">Receipt No.</td><td class="colon">:</td><td class="value"><%= data.receiptNo %></td></tr>
        <tr><td class="label">Chassis No.</td><td class="colon">:</td><td class="value"><%= data.chassisNo %></td></tr>
        <tr><td class="label">Vehicle Type</td><td class="colon">:</td><td class="value"><%= data.vehiclePermitType %></td></tr>
        <tr><td class="label">Vehicle Category</td><td class="colon">:</td><td class="value"><%= data.vehicleCategory %></td></tr>
        <tr><td class="label">CheckPost Name</td><td class="colon">:</td><td class="value"><%= data.borderBarrier %></td></tr>
        <tr><td class="label">Sleeper Cap</td><td class="colon">:</td><td class="value"><%= data.sleeperCapacity %></td></tr>
        <tr><td class="label">Payment Mode</td><td class="colon">:</td><td class="value"><%= data.paymentMode %></td></tr>
        <tr><td class="label">Service Type</td><td class="colon">:</td><td class="value"><%= data.serviceType %></td></tr>
        <tr><td class="label">Route</td><td class="colon">:</td><td class="value"><%= data.route %></td></tr>
      </table>

    </div>

    <!-- TAX TABLE -->
    <table class="tax-table">
      <thead>
        <tr>
          <th style="width:64%">Tax/Fee Particular</th>
          <th style="width:12%">Tax/Fees</th>
          <th style="width:12%">Fine</th>
          <th style="width:12%">Total</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r=>{ %>
        <tr>
          <td class="part"><%= r.particular %></td>
          <td class="num"><%= r.tax %></td>
          <td class="num"><%= r.fine %></td>
          <td class="num"><%= r.total %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="grand">
      Grand Total : <%= grandTotal %> /- (<%= data.totalAmountInWord %>)
    </div>

    <div class="section">
      <div class="hdr">Note :</div>
      <div class="hdr">Terms and Conditions:</div>
      <ol>
        <li>This is a computer generated printout and no signature is required.</li>
        <li>Should not carry unlawful/unaccompanied goods.</li>
        <li>If any false information/discrepancies are found later, action will be taken.</li>
      </ol>
    </div>

    <div class="footer-bold">
      Scan the QR code for genuinity of the receipt.
    </div>

  </div>
</div>

</body>
</html>
