<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Telangana - Checkpost Tax e-Receipt</title>

    <style>
      * {
        box-sizing: border-box;
      }

      @page {
        size: A4;
        margin: 0;
      }

      body {
        margin: 0;
        padding: 0;
        background: #fff;
        font-family: Arial, Helvetica, sans-serif;
        color: #000;
      }

      .page {
        width: 210mm;
        height: 297mm;
        padding: 14mm 16mm;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
      }

      /* repeated faint background text */
      .bg-text {
        position: absolute;
        inset: 0;
        padding: 18mm 16mm;
        opacity: 0.18;
        color: #6b6b6b;
        font-size: 12px;
        line-height: 1.55;
        z-index: 0;
        pointer-events: none;
      }

      .bg-text .row {
        white-space: nowrap;
        overflow: hidden;
      }

      /* center watermark emblem */
      .bg-emblem {
        position: absolute;
        left: 50%;
        top: 25%;
        transform: translate(-50%, -50%);
        width: 150px;
        height: 150px;
        opacity: 0.16;
        z-index: 0;
        pointer-events: none;
      }

      .content {
        position: relative;
        z-index: 1;
      }

      .top {
        display: grid;
        grid-template-columns: 90px 1fr 130px;
        align-items: start;
        column-gap: 10px;
        margin-bottom: 8px;
      }

      .top .logo {
        width: 90px;
        height: 90px;
        object-fit: contain;
      }

      .top .qr {
        width: 120px;
        height: 120px;
        object-fit: contain;
        justify-self: end;
      }

      .title {
        text-align: center;
        margin-top: 10px;
        line-height: 1.25;
      }

      .title .t1 {
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        text-decoration: underline;
      }

      .title .t2 {
        font-weight: 700;
        font-size: 12px;
        margin-top: 2px;
      }

      .title .t3 {
        font-weight: 700;
        font-size: 11px;
        margin-top: 2px;
      }

      .kv-wrap {
        margin-top: 6px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 28px;
        row-gap: 8px;
      }

      table.kv {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 12px;
      }

      table.kv td {
        padding: 2px 0;
        vertical-align: top;
      }

      table.kv td.label {
        width: 42%;
        white-space: nowrap;
        font-weight: 600;
      }

      table.kv td.colon {
        width: 4%;
        text-align: center;
        font-weight: 600;
      }

      table.kv td.value {
        width: 54%;
        font-weight: 700;
        word-break: break-word;
      }

      /* Tax table */
      .tax-table {
        margin-top: 18px;
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 11px;
      }

      .tax-table th,
      .tax-table td {
        border: 1px solid #6fa8ff;
        padding: 6px 8px;
      }

      .tax-table th {
        text-align: center;
        font-weight: 700;
      }

      .tax-table td.part {
        font-weight: 700;
      }

      .tax-table td.num {
        text-align: center;
        font-weight: 700;
        white-space: nowrap;
      }

      .grand {
        margin-top: 10px;
        font-size: 11px;
        font-weight: 700;
      }

      .section {
        margin-top: 8px;
        font-size: 11px;
      }

      .section .hdr {
        font-weight: 700;
        margin-bottom: 4px;
      }

      .section ol {
        margin: 0;
        padding-left: 18px;
      }

      .footer-bold {
        margin-top: 12px;
        font-size: 18px;
        font-weight: 800;
      }
    </style>
  </head>

  <body>
    <%
      const safe = (v) => (v === null || v === undefined) ? "" : String(v);

      const pick = (...vals) => {
        for (const v of vals) {
          if (v === null || v === undefined) continue;
          if (typeof v === "string" && v.trim() === "") continue;
          return v;
        }
        return "";
      };

      const toNum = (v) => {
        const n = Number(v);
        return Number.isFinite(n) ? n : 0;
      };

      const bgLine = `${safe(pick(data.vehicleNo))} ${safe(
        pick(data.receiptDate, data.paymentDate, data.upPaymentDate)
      )}`.trim();

      const taxFrom = safe(pick(data.taxFrom_up, data.taxFrom, data.taxFromDate));
      const taxTo = safe(
        pick(data.taxTo_up, data.taxTo, data.taxUptoDate, data.taxUpto)
      );

      const permitFeeAmt = pick(
        data.permitFeeAmount,
        data.permitFee,
        data.permitFeeAmt
      );
      const permitFine = pick(data.permitFeeFine, data.permitFine);
      const permitTotal = pick(
        data.permitFeeTotal,
        toNum(permitFeeAmt) + toNum(permitFine)
      );

      const mvAmt = pick(
        data.mvTaxAmount,
        data.mvTax,
        data.mvTaxAmt,
        data.totalAmount
      );
      const mvFine = pick(data.mvTaxFine, data.mvFine);
      const mvTotal = pick(
        data.mvTaxTotal,
        toNum(mvAmt) + toNum(mvFine)
      );

      const svcAmt = pick(
        data.serviceAmount,
        data.userCharge,
        data.serviceUserCharge
      );
      const svcFine = pick(data.serviceFine, data.userChargeFine);
      const svcTotal = pick(
        data.serviceTotal,
        toNum(svcAmt) + toNum(svcFine)
      );

      const tokenAmt = pick(
        data.taxTokenFee,
        data.taxTokenFeeAmount,
        data.tokenFeeAmount,
        data.tokenFee
      );
      const tokenFine = pick(data.tokenFeeFine, data.tokenFine);
      const tokenTotal = pick(
        data.tokenFeeTotal,
        toNum(tokenAmt) + toNum(tokenFine)
      );

      const rows = [
        permitFeeAmt !== ""
          ? {
              particular: `Permit Fee (${taxFrom} To ${taxTo})`,
              taxFees: permitFeeAmt,
              fine: permitFine,
              total: permitTotal,
            }
          : null,
        {
          particular: `MV Tax (${taxFrom} To ${taxTo})`,
          taxFees: mvAmt,
          fine: mvFine,
          total: mvTotal,
        },
        svcAmt !== ""
          ? {
              particular: `Service/User Charge (${taxFrom} To ${taxTo})`,
              taxFees: svcAmt,
              fine: svcFine,
              total: svcTotal,
            }
          : null,
        tokenAmt !== ""
          ? {
              particular: `Tax Token Fee (${taxFrom} To ${taxTo})`,
              taxFees: tokenAmt,
              fine: tokenFine,
              total: tokenTotal,
            }
          : null,
      ].filter(Boolean);

      const computedGrand = rows.reduce((s, r) => s + toNum(r.total), 0);
      const grandTotal =
        data.grandTotal !== null &&
        data.grandTotal !== undefined &&
        String(data.grandTotal) !== ""
          ? toNum(data.grandTotal)
          : computedGrand;

      const grandWords = safe(
        pick(data.grandTotalWords, data.totalAmountInWord)
      );

      const grossCombWt = pick(
        data.grossCombinationWeight,
        data.grossCombinationWeightInKg,
        data.grossCombinationWeightKg,
        data.grossVehicleWeight,
        data.grossVehicleWeightInKg,
        data.grossVehicleWeightKg
      );

      const seatingCap = pick(
        data.seatingCapacityExcludingDriver,
        data.seatingCapacity,
        data.seatCapacity
      );

      const sleeperCap = pick(
        data.sleeperCapacityExcludingDriver,
        data.sleeperCapacity,
        data.sleeperCap
      );

      const vehicleType = pick(data.vehicleType, data.vehiclePermitType);
      const checkpost = pick(
        data.checkpostName,
        data.checkPostName,
        data.borderBarrier
      );
    %>
  </body>
</html>
