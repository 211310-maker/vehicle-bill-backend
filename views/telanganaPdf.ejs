<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Telangana - Checkpost Tax e-Receipt</title>

<style>
* { box-sizing: border-box; }
@page { size: A4; margin: 0; }

body {
  margin: 0;
  background: #fff;
  font-family: Arial, Helvetica, sans-serif;
  color: #000;
}

.page {
  width: 210mm;
  height: 297mm;
  padding: 14mm 16mm;
  position: relative;
  overflow: hidden;
}

/* ================= BACKGROUND TEXT ================= */
.bg-text {
  position: absolute;
  inset: 0;
  padding: 18mm 16mm;
  opacity: 0.18;
  color: #6b6b6b;
  font-size: 11px;
  line-height: 1.55;
  z-index: 0;
  pointer-events: none;
}
.bg-text .row {
  white-space: nowrap;
}

/* ================= WATERMARK (FIXED) ================= */
.bg-emblem {
  position: absolute;
  left: 50%;
  top: 45%;
  transform: translate(-50%, -50%);
  width: 135px;
  height: 135px;
  opacity: 0.16;
  z-index: 0;
  pointer-events: none;
}

/* ================= HEADER (ABSOLUTE – OG STYLE) ================= */
.logo {
  position: absolute;
  top: 14mm;
  left: 16mm;
  width: 70px;
  height: 70px;
  object-fit: contain;
}

.qr {
  position: absolute;
  top: 14mm;
  right: 16mm;
  width: 110px;
  height: 110px;
  object-fit: contain;
}

.header {
  position: absolute;
  top: 18mm;
  left: 0;
  right: 0;
  text-align: center;
  line-height: 1.25;
}

.header .t1 {
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  text-decoration: underline;
}
.header .t2 {
  font-weight: 700;
  font-size: 11px;
  margin-top: 2px;
}
.header .t3 {
  font-weight: 700;
  font-size: 10px;
  margin-top: 2px;
}

/* ================= CONTENT ================= */
.content {
  position: relative;
  margin-top: 95px;
  z-index: 1;
}

/* ================= DETAILS ================= */
.kv-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 26px;
}

table.kv {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: 11px;
}

table.kv td {
  padding: 1.5px 0;
  vertical-align: top;
}

td.label {
  width: 42%;
  font-weight: 600;
  white-space: nowrap;
}
td.colon {
  width: 4%;
  text-align: center;
  font-weight: 600;
}
td.value {
  width: 54%;
  font-weight: 700;
  word-break: break-word;
}

/* ================= TAX TABLE ================= */
.tax-table {
  margin-top: 16px;
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

.tax-table th,
.tax-table td {
  border: 1px solid #6fa8ff;
  padding: 6px 8px;
}

.tax-table th {
  text-align: center;
  font-weight: 700;
}

.tax-table td.part {
  font-weight: 700;
}

.tax-table td.num {
  text-align: center;
  font-weight: 700;
}

/* ================= FOOTER ================= */
.grand {
  margin-top: 8px;
  font-size: 11px;
  font-weight: 700;
}

.section {
  margin-top: 6px;
  font-size: 11px;
}

.section .hdr {
  font-weight: 700;
}

.section ol {
  margin: 0;
  padding-left: 16px;
}

.footer-bold {
  margin-top: 10px;
  font-size: 16px;
  font-weight: 800;
}
</style>
</head>

<body>

<%
  /* ===== helpers (UNCHANGED) ===== */
  const safe = (v) => (v === null || v === undefined) ? "" : String(v);
  const pick = (...vals) => {
    for (const v of vals) {
      if (v === null || v === undefined) continue;
      if (typeof v === "string" && v.trim() === "") continue;
      return v;
    }
    return "";
  };
  const toNum = (v) => {
    const n = Number(v);
    return Number.isFinite(n) ? n : 0;
  };

  const bgLine = `${safe(pick(data.vehicleNo))} ${safe(pick(data.receiptDate, data.paymentDate))}`.trim();
  const taxFrom = safe(pick(data.taxFrom_up, data.taxFrom, data.taxFromDate));
  const taxTo   = safe(pick(data.taxTo_up, data.taxTo, data.taxUptoDate, data.taxUpto));

  const rows = [
    {
      particular: `MV Tax (${taxFrom} To ${taxTo})`,
      taxFees: data.mvTax || 0,
      fine: 0,
      total: data.mvTax || 0
    },
    {
      particular: `Service/User Charge (${taxFrom} To ${taxTo})`,
      taxFees: data.userCharge || 0,
      fine: 0,
      total: data.userCharge || 0
    },
    {
      particular: `Tax Token Fee (${taxFrom} To ${taxTo})`,
      taxFees: data.taxTokenFee || 0,
      fine: 0,
      total: data.taxTokenFee || 0
    }
  ];
%>

<div class="page">

  <!-- BACKGROUND TEXT -->
  <div class="bg-text">
    <% for (let i = 0; i < 26; i++) { %>
      <div class="row">
        <%= bgLine %>&nbsp;&nbsp;&nbsp;<%= bgLine %>&nbsp;&nbsp;&nbsp;<%= bgLine %>
      </div>
    <% } %>
  </div>

  <!-- WATERMARK -->
  <img class="bg-emblem" src="/images1/Telangana.png" />

  <!-- HEADER -->
  <img class="logo" src="/images1/Telangana.png" />
  <% if (data.src) { %>
    <img class="qr" src="<%= data.src %>" />
  <% } %>

  <div class="header">
    <div class="t1">GOVERNMENT OF TELANGANA</div>
    <div class="t2">Department of Transport</div>
    <div class="t3">Checkpost Tax e-Receipt (Single Journey)</div>
  </div>

  <!-- CONTENT -->
  <div class="content">

    <div class="kv-wrap">
      <table class="kv">
        <tr><td class="label">Registration No.</td><td class="colon">:</td><td class="value"><%= pick(data.vehicleNo) %></td></tr>
        <tr><td class="label">Owner Name</td><td class="colon">:</td><td class="value"><%= pick(data.ownerName) %></td></tr>
        <tr><td class="label">Tax Mode</td><td class="colon">:</td><td class="value"><%= pick(data.taxMode) %></td></tr>
        <tr><td class="label">Vehicle Class</td><td class="colon">:</td><td class="value"><%= pick(data.vehicleClass) %></td></tr>
        <tr><td class="label">Mobile No.</td><td class="colon">:</td><td class="value"><%= pick(data.mobileNo) %></td></tr>
      </table>

      <table class="kv">
        <tr><td class="label">Receipt No.</td><td class="colon">:</td><td class="value"><%= pick(data.receiptNo) %></td></tr>
        <tr><td class="label">Chassis No.</td><td class="colon">:</td><td class="value"><%= pick(data.chassisNo) %></td></tr>
        <tr><td class="label">Vehicle Type</td><td class="colon">:</td><td class="value"><%= pick(data.vehicleType) %></td></tr>
        <tr><td class="label">Payment Mode</td><td class="colon">:</td><td class="value"><%= pick(data.paymentMode) %></td></tr>
        <tr><td class="label">Route</td><td class="colon">:</td><td class="value"><%= pick(data.route) %></td></tr>
      </table>
    </div>

    <table class="tax-table">
      <thead>
        <tr>
          <th style="width:64%">Tax/Fee Particular</th>
          <th>Tax/Fees</th>
          <th>Fine</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td class="part"><%= r.particular %></td>
            <td class="num"><%= r.taxFees %></td>
            <td class="num"><%= r.fine %></td>
            <td class="num"><%= r.total %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="grand">
      Grand Total : <%= data.grandTotal %> /- <%= data.grandTotalWords %>
    </div>

    <div class="section">
      <div class="hdr">Note :</div>
      <ol>
        <li>This is a computer generated printout and no signature is required.</li>
        <li>Should not carry unlawful/unaccompanied goods.</li>
        <li>If any false information is found later, action will be taken.</li>
      </ol>
    </div>

    <div class="footer-bold">Scan the QR code for genuinity of the receipt.</div>

  </div>
</div>

</body>
</html>
