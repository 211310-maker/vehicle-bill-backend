<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Bill - <%= data.vehicleNo || '' %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    .header { margin-bottom: 12px; }
    .meta { margin-bottom: 8px; }
    .amount { font-weight: bold; }
    img.qr { width: 120px; height: 120px; }
  </style>
</head>
<body>
  <div class="header">
    <h2>Vehicle Bill - <%= (data.rtoName || 'Telangana') %></h2>
  </div>

  <div class="meta">
    <div>Vehicle No: <%= data.vehicleNo || 'N/A' %></div>
    <div>Owner: <%= data.ownerName || 'N/A' %></div>
    <div>Chassis: <%= data.chassisNo || 'N/A' %></div>
    <div>Tax valid: <%= data.taxFrom || 'N/A' %> to <%= data.taxTo || 'N/A' %></div>
  </div>

  <div class="amount">
    Amount Paid: ₹<%= data.totalAmount != null ? data.totalAmount : '0' %>
    (<%= data.totalAmountInWord || '' %>)
  </div>

  <div style="margin-top:16px;">
    <% if (data.src) { %>
      <img class="qr" src="<%= data.src %>" alt="QR code" />
    <% } else { %>
      <div>No QR</div>
    <% } %>
  </div>
</body>
</html>
