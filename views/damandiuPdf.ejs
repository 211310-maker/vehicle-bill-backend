<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Daman & Diu - Tax Receipt</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
    rel="stylesheet"
  />

  <style>
    * { box-sizing: border-box; }

    @page {
      size: A4;
      margin: 0;
    }

    body {
      margin: 0;
      padding: 0;
      background: #fff;
      font-family: "Roboto", Arial, Helvetica, sans-serif;
      color: #000;
      font-size: 12px;
    }

    /* Center the A4 sheet in browser view */
    .page {
      width: 100vw;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      background: #fff;
    }

    /* A4 canvas */
    .main {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 12mm 15mm; /* same as Puducherry */
      position: relative;
      background: #fff;
      overflow: hidden;
    }

    .content { position: relative; z-index: 3; }

    /* Watermark EXACT center */
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 340px;          /* bigger */
      opacity: 0.07;
      z-index: 1;
      pointer-events: none;
    }

    /* Background repeated vehicle/date across full width */
    .bg-repeat {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0.09;
      pointer-events: none;
      font-size: 14px;
      line-height: 1.35;
    }

    .bg-repeat p {
      margin: 0;
      padding: 0 10px;
      display: flex;
      justify-content: space-between; /* push 2 repeats across width */
      white-space: nowrap;
      font-weight: 500;
    }

    /* Header layout */
    .header {
      display: table;
      width: 100%;
      margin-bottom: 14px;
    }

    .header-cell {
      display: table-cell;
      vertical-align: top;
    }

    .header-logo { width: 22%; }
    .header-logo img { width: 85px; height: auto; }

    .header-center {
      width: 56%;
      text-align: center;
      line-height: 1.35;
      padding-top: 4px;
    }

    .header-center .gov {
      font-size: 15px;
      font-weight: 900;
      text-transform: uppercase;
    }
    .header-center .dept {
      font-size: 13px;
      font-weight: 700;
    }
    .header-center .title {
      font-size: 13px;
      font-weight: 700;
    }

    .header-qr { width: 22%; text-align: right; }
    .header-qr img {
      width: 120px;
      height: 120px;
      object-fit: contain;
    }

    /* DETAILS TABLE (CRITICAL FIX) */
    table.details {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;   /* force 4 columns */
      font-size: 12.5px;
      margin-top: 4px;
    }

    table.details td {
      padding: 3px 2px;
      vertical-align: top;
    }

    table.details td.label {
      font-weight: 400;
      white-space: nowrap;
    }

    table.details td.value {
      font-weight: 800; /* bold like screenshot */
      white-space: normal;
    }

    /* TAX TABLE */
    table.tax {
      width: 100%;
      border-collapse: collapse;
      margin-top: 14px;
      font-size: 12px;
    }

    table.tax th, table.tax td {
      border: 1px solid #0070c0;
      padding: 5px 6px;
    }

    table.tax th {
      text-align: center;
      font-weight: 800;
    }

    table.tax td.num {
      text-align: right;
      width: 12%;
      font-weight: 700;
    }

    .grand {
      margin-top: 8px;
      font-size: 12.5px;
    }

    .grand .gt {
      font-weight: 900;
    }

    .terms-title {
      margin-top: 4px;
      font-weight: 900;
    }

    .terms-list {
      margin: 2px 0 0 16px;
      padding: 0;
      font-size: 12px;
    }

    .bottom-note {
      margin-top: 10px;
      font-size: 12.5px;
      font-weight: 900;
    }

    .url {
      color: #0070c0;
      text-decoration: underline;
      font-weight: 800;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="main">

      <!-- Watermark -->
      <img
        src="<%= data.host %>/images1/Daman.jpg"
        class="watermark"
        alt="Watermark"
      />

      <!-- Repeated background vehicle/payment -->
      <div class="bg-repeat">
        <% for (let i = 0; i < 22; i++) { %>
          <p>
            <span><%= data.vehicleNo %> / <%= data.paymentDate %></span>
            <span><%= data.vehicleNo %> / <%= data.paymentDate %></span>
          </p>
        <% } %>
      </div>

      <div class="content">
        <!-- HEADER -->
        <div class="header">
          <div class="header-cell header-logo">
            <img src="<%= data.host %>/images1/Daman.jpg" alt="Logo" />
          </div>

          <div class="header-cell header-center">
            <div class="gov">GOVERNMENT OF DAMAN &amp; DIU</div>
            <div class="dept">Department of Transport</div>
            <div class="title">Checkpost Tax e-Receipt</div>
          </div>

          <div class="header-cell header-qr">
            <% if (data.src) { %>
              <img src="<%= data.src %>" alt="QR Code" />
            <% } %>
          </div>
        </div>

        <!-- DETAILS (4-column fixed like Puducherry) -->
        <table class="details">
          <colgroup>
            <col style="width:22%">
            <col style="width:28%">
            <col style="width:22%">
            <col style="width:28%">
          </colgroup>

          <tr>
            <td class="label">Registration No.</td>
            <td class="value">: <%= data.vehicleNo %></td>
            <td class="label">Receipt No.</td>
            <td class="value">: <%= data.receiptNo %></td>
          </tr>

          <tr>
            <td class="label">Payment Date</td>
            <td class="value">: <%= data.paymentDate %></td>
            <td class="label">Owner Name</td>
            <td class="value">: <%= data.ownerName %></td>
          </tr>

          <tr>
            <td class="label">Chassis No.</td>
            <td class="value">: <%= data.chassisNo %></td>
            <td class="label">Tax Mode</td>
            <td class="value">: <%= data.taxMode %></td>
          </tr>

          <tr>
            <td class="label">Vehicle Type</td>
            <td class="value">: <%= data.vehiclePermitType %></td>
            <td class="label">Vehicle Class</td>
            <td class="value">: <%= data.vehicleClass %></td>
          </tr>

          <tr>
            <td class="label">Mobile No.</td>
            <td class="value">: <%= data.mobileNo %></td>
            <td class="label">Checkpost Name</td>
            <td class="value">: <%= data.borderBarrier %></td>
          </tr>
        </table>

        <!-- TAX/FEE TABLE (like image) -->
        <table class="tax">
          <thead>
            <tr>
              <th>Tax/Fee Particular</th>
              <th>Tax/Fees</th>
              <th>Fine</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>MV Tax ( <%= data.taxFrom %> to <%= data.taxTo %> )</b></td>
              <td class="num"><%= data.totalAmount %></td>
              <td class="num">0</td>
              <td class="num"><%= data.totalAmount %></td>
            </tr>
          </tbody>
        </table>

        <!-- GRAND TOTAL + TERMS (like image) -->
        <div class="grand">
          <div class="gt">
            Grand Total : <%= data.totalAmount %>/- ( <%= data.totalAmountInWord %> )
          </div>

          <div class="terms-title">Terms and Conditions:</div>
          <ol class="terms-list">
            <li>This is a computer generated printout and no signature is required.</li>
            <li>Incorrect mentioning of vehicle class or seating capacity may lead to penal action.</li>
          </ol>

          <div class="bottom-note">
            Scan the QR code for genuinity of the receipt, It should land at
            <span class="url">https://kms.parivahan.gov.in</span> site.
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
</html>
