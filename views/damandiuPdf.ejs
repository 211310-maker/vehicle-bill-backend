<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
  <% if (data.cssFix) { %>
  <link rel="stylesheet" href="/css/cssFix.css" />
  <% } %>

  <style>
    /* Full-page A4 and remove browser header/footer space */
    @page {
      size: A4;
      margin: 0 !important;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Roboto", sans-serif;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Prevent :after URL on links when printing */
    @media print {
      a[href]:after {
        content: "" !important;
      }
    }

    /* MAIN PAGE WRAPPER */
    .page-daman {
      position: relative;
      width: 100%;
      box-sizing: border-box;
      padding: 25px 40px 40px 40px;
    }

    /* QR TOP-RIGHT */
    .qr-image-daman {
      position: absolute;
      top: 22px;
      right: 55px;
      width: 135px;
      height: 135px;
      object-fit: contain;
      z-index: 15;
    }

    /* SMALL LOGO TOP-LEFT */
    .logo-daman-small {
      position: absolute;
      top: 22px;
      left: 45px;
      z-index: 15;
    }
    .logo-daman-small img {
      width: 110px;
      height: auto;
      display: block;
    }

    /* BIG CENTER WATERMARK */
    .logo-daman-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.13;
      z-index: 2;
      pointer-events: none;
    }
    .logo-daman-watermark img {
      width: 320px;   /* make slightly bigger / adjust if needed */
      height: auto;
    }

    /* BACKGROUND VEHICLE + DATE TEXT */
    .content__back {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      opacity: 0.07;
      z-index: 1;
      pointer-events: none;
      font-size: 11px;
    }
    .content__back p {
      margin: 0;
      line-height: 1.4;
      white-space: nowrap;
    }

    /* MAIN CONTENT ABOVE BACKGROUND & WATERMARK */
    .content-daman,
    .content-daman * {
      position: relative;
      z-index: 5;
    }

    .content-daman {
      margin-top: 110px; /* leave space for logo + QR + title */
      font-size: 12px;
    }

    .daman-header {
      text-align: center;
      margin-bottom: 12px;
    }
    .daman-header h3 {
      margin: 0 0 3px 0;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.4px;
    }
    .daman-header p {
      margin: 0;
      font-size: 13px;
    }

    /* INFO TABLE (top details) */
    .info-table-daman {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 8px;
    }
    .info-table-daman td {
      padding: 2px 4px;
      vertical-align: top;
    }

    /* TAX / FEE TABLE */
    .money-table-daman {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 16px;
      border-top: 1px solid #000;
      border-left: 1px solid #000;
      border-right: 1px solid #000;
    }
    .money-table-daman th,
    .money-table-daman td {
      border-bottom: 1px solid #000;
      border-right: 1px solid #000;
      padding: 4px 6px;
      text-align: center;
    }
    .money-table-daman th:first-child,
    .money-table-daman td:first-child {
      text-align: left;
    }

    /* GRAND TOTAL + NOTES */
    .grand-daman {
      margin-top: 14px;
      font-size: 12px;
      line-height: 18px;
    }
    .grand-daman p {
      margin: 3px 0;
    }

    .grand-daman .note-label {
      font-weight: 700;
    }

    .grand-daman .terms-label {
      font-weight: 700;
    }

    .grand-daman-terms {
      margin-left: 16px;
      font-style: italic;
    }

    .grand-daman-terms p {
      margin: 2px 0;
    }

    .scan-warning {
      margin-top: 14px;
      font-size: 13px;
      line-height: 20px;
    }
  </style>
</head>

<body>
  <div class="page-daman">
    <!-- QR top-right -->
    <img class="qr-image-daman" src="<%= data.src %>" alt="" />

    <!-- Small logo top-left -->
    <div class="logo-daman-small">
      <img src="/images1/Daman.jpg" alt="Daman & Diu Logo" />
    </div>

    <!-- Big center watermark -->
    <div class="logo-daman-watermark">
      <img src="/images1/Daman.jpg" alt="Daman & Diu Watermark" />
    </div>

    <!-- Background vehicle + date text -->
    <div class="content__back">
      <% for (let i = 0; i < 18; i++) { %>
      <p>
        <span><%= data.vehicleNo %> / <%= data.paymentDate %>,</span>&nbsp;
        <span><%= data.vehicleNo %> / <%= data.paymentDate %>,</span>
      </p>
      <% } %>
    </div>

    <!-- FOREGROUND CONTENT -->
    <div class="content-daman">
      <!-- Title -->
      <div class="daman-header">
        <h3>GOVERNMENT OF DAMAN &amp; DIU</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <!-- Info table (two column layout like reference) -->
      <table class="info-table-daman">
        <tr>
          <td>Registration No.</td>
          <td>: <b><%= data.vehicleNo %></b></td>
          <td>Receipt No.</td>
          <td>: <%= data.receiptNo %></td>
        </tr>
        <tr>
          <td>Payment Date</td>
          <td>: <%= data.paymentDate %></td>
          <td>Owner Name</td>
          <td>: <%= data.ownerName %></td>
        </tr>
        <tr>
          <td>Chassis No.</td>
          <td>: <%= data.chassisNo %></td>
          <td>Tax Mode</td>
          <td>: <%= data.taxMode %></td>
        </tr>
        <tr>
          <td>Vehicle Type</td>
          <td>: <%= data.vehiclePermitType %></td>
          <td>Vehicle Class</td>
          <td>: <%= data.vehicleClass %></td>
        </tr>
        <tr>
          <td>Mobile No.</td>
          <td>: <%= data.mobileNo %></td>
          <td>Checkpost Name</td>
          <td>: <%= data.borderBarrier %></td>
        </tr>
        <tr>
          <td>Sleeper Cap.</td>
          <td>: <%= data.sleeperCapacityExcludingDriver %></td>

          <% if (data.vehiclePermitType === 'GOODS VEHICLE') { %>
            <td>Gross Weight</td>
            <td>: <%= data.grossVehicleWeight %> KG</td>
          <% } else { %>
            <td>Seating Capacity</td>
            <td>: <%= data.seatingCapacityExcludingDriver %></td>
          <% } %>
        </tr>
        <tr>
          <td>Payment Mode</td>
          <td>: <%= data.paymentMode %></td>
          <td>Bank Ref. No.</td>
          <td>: NA</td>
        </tr>
        <tr>
          <td>Permit Type</td>
          <td>: <%= data.permitType %></td>
          <td>Service Type</td>
          <td>: NOT APPLICABLE</td>
        </tr>
      </table>

      <!-- Tax/Fee table like reference -->
      <table class="money-table-daman">
        <thead>
          <tr>
            <th>Tax/Fee Particular</th>
            <th>Tax/Fees</th>
            <th>Fine</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>MV Tax ( <%= data.taxFrom %> to <%= data.taxTo %> )</td>
            <td><%= data.totalAmount %></td>
            <td>0</td>
            <td><%= data.totalAmount %></td>
          </tr>
        </tbody>
      </table>

      <!-- Grand Total + Note + Terms exactly style-wise -->
      <div class="grand-daman">
        <p>
          <b>Grand Total : <%= data.totalAmount %>/- <%= data.totalAmountInWord %></b>
        </p>

        <p class="note-label">Note :</p>
        <p class="terms-label">Terms and Conditions:</p>

        <div class="grand-daman-terms">
          <p>1) This is a computer generated printout and no signature is required.</p>
          <p>2) Should not carry unlawful/unaccompanied goods.</p>
          <p>
            3) If any false information/discrepancies are found at later, necessary action will be taken
            against the vehicle owner/driver.
          </p>
        </div>

        <p class="scan-warning">
          Scan the QR code for genuinity of the receipt, It should land at
          <a style="color: blue; text-decoration: none;">https://kms.privahan.gov.in</a>
          site. In case the URL is different, then receipt could be a fake one, please raise a complain.
        </p>
      </div>
    </div>
  </div>
</body>
</html>
