<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Daman & Diu - Tax Receipt</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="<%= data.host %>/css/style.css" />
    <% if (data.cssFix) { %>
      <link rel="stylesheet" href="<%= data.host %>/css/cssFix.css" />
    <% } %>

    <style>
      * {
        box-sizing: border-box;
      }

      /* Full A4 page, no extra print header/footer margin space */
      @page {
        size: A4;
        margin: 0;
      }

      body {
        margin: 0;
        padding: 0;
        background: #fff;
        font-family: "Roboto", Arial, Helvetica, sans-serif;
        color: #000;
        font-size: 12px;
      }

      .main {
        width: 210mm;              /* same width as Puducherry */
        margin: 0 auto;
        padding: 12mm 15mm;        /* inner margins like Puducherry */
        position: relative;
      }

      .content {
        position: relative;
        z-index: 2;                /* above watermark + bg text */
      }

      /* centered watermark */
      .watermark {
        position: absolute;
        top: 230px;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0.07;
        width: 260px;
        z-index: 0;
        pointer-events: none;
      }

      /* BACKGROUND VEHICLE / DATE TEXT (like Assam sample) */
      .bg-repeat {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1;
        opacity: 0.07;
        font-size: 16px;
        line-height: 1.2;
        pointer-events: none;
      }

      .bg-repeat p {
        margin: 0;
        padding-left: 8px;
        white-space: nowrap;
        font-weight: 500;
      }

      /* HEADER LAYOUT (logo left, title center, QR right) */
      .header {
        display: table;
        width: 100%;
        margin-bottom: 14px;
      }

      .header-cell {
        display: table-cell;
        vertical-align: top;
      }

      .header-logo {
        width: 22%;
      }

      .header-logo img {
        width: 80px;
        height: auto;
      }

      .header-center {
        width: 56%;
        text-align: center;
        line-height: 1.3;
        padding-top: 4px;
      }

      .header-center .gov {
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
      }

      .header-center .dept {
        font-size: 12px;
        font-weight: 500;
      }

      .header-center .title {
        font-size: 12px;
        font-weight: 500;
      }

      .header-qr {
        width: 22%;
        text-align: right;
      }

      .header-qr img {
        width: 120px;
        height: 120px;
        object-fit: contain;
      }

      /* MAIN DETAILS TABLE */
      table.details {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
        font-size: 12px;
      }

      table.details td {
        padding: 2px 2px;
        vertical-align: top;
      }

      table.details td.label {
        white-space: nowrap;
      }

      table.details td.value {
        padding-left: 2px;
        font-weight: bold;
      }

      /* TAX TABLE */
      .content__money {
        margin-top: 14px;
        font-size: 12px;
      }

      .content__money-r1,
      .content__money-r2 {
        display: table;
        width: 100%;
        border-collapse: collapse;
      }

      .content__money-r1 > div,
      .content__money-r2 > div {
        display: table-cell;
        padding: 4px 6px;
        border: 1px solid #0070c0;
      }

      .content__money-r1 {
        font-weight: bold;
        text-align: center;
      }

      .content__money-r2 .m1 {
        width: 60%;
      }

      .content__money-r2 .m2,
      .content__money-r2 .m3,
      .content__money-r2 .m4 {
        width: 13.33%;
        text-align: right;
      }

      .content__grand {
        margin-top: 10px;
        font-size: 12px;
      }

      .content__grand p {
        margin: 2px 0;
      }

      .content__grand b {
        font-weight: 600;
      }

      .terms-title {
        font-weight: bold;
        margin-top: 4px;
        margin-bottom: 2px;
      }

      .terms-list {
        margin: 0 0 0 16px;
        padding: 0;
      }

      .terms-list li {
        margin-bottom: 2px;
      }

      .bottom-note {
        margin-top: 10px;
        font-size: 12px;
        font-weight: bold;
      }

      .bottom-note a {
        color: #0070c0;
        text-decoration: underline;
      }

      /* Try to avoid browser appending URL text after links on print */
      @media print {
        a[href]:after {
          content: "" !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="main">
      <!-- Center watermark -->
      <img
        src="<%= data.host %>/images1/Daman.jpg"
        class="watermark"
        alt="Watermark"
      />

      <!-- Repeated background vehicleNo / paymentDate -->
      <div class="bg-repeat">
        <% for (let i = 0; i < 18; i++) { %>
          <p><%= data.vehicleNo %> / <%= data.paymentDate %></p>
        <% } %>
      </div>

      <div class="content">
        <!-- HEADER -->
        <div class="header">
          <div class="header-cell header-logo">
            <img
              src="<%= data.logoSrc || (data.host + '/images1/Daman.jpg') %>"
              alt="Logo"
            />
          </div>

          <div class="header-cell header-center">
            <div class="gov">GOVERNMENT OF DAMAN &amp; DIU</div>
            <div class="dept">Department of Transport</div>
            <div class="title">Checkpost Tax e-Receipt</div>
          </div>

          <div class="header-cell header-qr">
            <% if (data.src) { %>
              <img src="<%= data.src %>" alt="QR Code" />
            <% } %>
          </div>
        </div>

        <!-- MAIN DETAILS (same fields as your original file) -->
        <table class="details">
          <tr class="r1 r11">
            <td class="label">Registration No.</td>
            <td class="value">: <%= data.vehicleNo %></td>
          </tr>
          <tr class="r1 r12">
            <td class="label">Receipt No.</td>
            <td class="value">: <%= data.receiptNo %></td>
          </tr>
          <tr class="r1 r13">
            <td class="label">Payment Date</td>
            <td class="value">: <%= data.paymentDate %></td>
          </tr>
          <tr class="r1 r14">
            <td class="label">Owner Name</td>
            <td class="value">: <%= data.ownerName %></td>
          </tr>
          <tr class="r1 r15">
            <td class="label">Chassis No.</td>
            <td class="value">: <%= data.chassisNo %></td>
            <td class="label">Tax Mode</td>
            <td class="value">: <%= data.taxMode %></td>
          </tr>
          <tr class="r1 r16">
            <td class="label">Vehicle Type</td>
            <td class="value">
              : <%= data.vehiclePermitType %>
            </td>
            <td class="label">Vehicle Class</td>
            <td class="value">: <%= data.vehicleClass %></td>
          </tr>
          <tr class="r1 r17">
            <td class="label">Mobile No.</td>
            <td class="value">: <%= data.mobileNo %></td>
            <td class="label">Checkpost Name</td>
            <td class="value">: <%= data.borderBarrier %></td>
          </tr>
          <tr class="r1 r18">
            <td class="label">Sleeper Cap.</td>
            <td class="value">
              : <%= data.sleeperCapacityExcludingDriver %>
            </td>
            <% if (data.vehiclePermitType === 'GOODS VEHICLE') { %>
              <td class="label">Gross Weight</td>
              <td class="value">: <%= data.grossVehicleWeight %> KG.</td>
            <% } else { %>
              <td class="label">
                Seating Cap(Ex. Driver)
              </td>
              <td class="value">: <%= data.seatingCapacityExcludingDriver %></td>
            <% } %>
          </tr>
          <tr class="r1 r19">
            <td class="label">Bank Ref. No.</td>
            <td class="value">: NA</td>
            <td class="label">Payment Mode</td>
            <td class="value">: <%= data.paymentMode %></td>
          </tr>
          <tr class="r1 r20">
            <td class="label">Service Type</td>
            <td class="value">: NOT APPLICABLE</td>
          </tr>
          <tr class="r1 r21">
            <td class="label">Permit Type</td>
            <td class="value">: <%= data.permitType %></td>
            <td class="label">Permit Category</td>
            <td class="value">:</td>
          </tr>
        </table>

        <!-- TAX TABLE (same as original MV tax only) -->
        <div class="content__money">
          <div class="content__money-r1">
            <div class="m1"><b>Tax/Fee Particular</b></div>
            <div class="m2"><b>Tax/Fees</b></div>
            <div class="m3"><b>Fine</b></div>
            <div class="m4"><b>Total</b></div>
          </div>
          <div class="content__money-r2">
            <div class="m1">
              MV Tax ( <%= data.taxFrom %> to <%= data.taxTo %> )
            </div>
            <div class="m2"><%= data.totalAmount %></div>
            <div class="m3">0</div>
            <div class="m4"><%= data.totalAmount %></div>
          </div>
        </div>

        <!-- GRAND TOTAL + TERMS -->
        <div class="content__grand content__grand--hr">
          <p>
            <b>
              Grand Total : ₹ <%= data.totalAmount %>/- (
              <%= data.totalAmountInWord %> )
            </b>
          </p>

          <p><b>Note :</b></p>
          <p class="terms-title">Terms and Conditions:</p>
          <ol class="terms-list">
            <li>
              This is a computer generated printout and no signature is
              required.
            </li>
            <li>
              Incorrect mentioning of vehicle class or seating capacity may
              lead to tax evasion and defaulter shall be liable for penal
              action.
            </li>
          </ol>

          <div class="bottom-note">
            Scan the QR code for genuinity of the receipt, It should land at
            <a href="https://kms.privahan.gov.in">https://kms.privahan.gov.in</a>
            site. In case the URL is different, then receipt could be a fake
            one, please raise a complain.
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
