<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/style.css" />
  <% if(data.cssFix){ %>
  <link rel="stylesheet" href="/css/cssFix.css" />
  <% } %>

  <!-- REMOVE PDF URL + PAGE NUMBER + HEADER FOOTER SPACE -->
  <style>
    @page {
      margin: 0 !important;
    }
    @media print {
      a[href]:after {
        content: "" !important;
      }
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Roboto", sans-serif;
    }

    .main {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
      padding: 25px 30px 40px 30px;
      box-sizing: border-box;
    }

    /* QR TOP-RIGHT */
    .qr-image {
      position: absolute;
      top: 20px;
      right: 35px;
      width: 130px;
      height: 130px;
      object-fit: contain;
      z-index: 10;
    }

    /* NEW SMALL LOGO TOP-LEFT */
    .logo__daman {
      position: absolute;
      top: 22px;
      left: 40px;
      z-index: 12;
    }
    .logo__daman img {
      width: 110px;
      height: auto;
      display: block;
    }

    /* BACKGROUND VEHICLE NO + DATE */
    .content__back {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      opacity: 0.07;
      z-index: 1;
      pointer-events: none;
      font-size: 11px;
    }
    .content__back p {
      margin: 0;
      padding: 0;
      line-height: 1.4;
      white-space: nowrap;
    }

    /* MAIN CONTENT ABOVE BACKGROUND */
    .content,
    .content__top,
    table,
    .content__grand {
      position: relative;
      z-index: 5;
    }

    /* CONTENT START BELOW LOGO + QR */
    .content {
      margin-top: 105px;
    }

    .content__top {
      text-align: center;
      margin-bottom: 12px;
    }
    .content__top h3 {
      margin: 0 0 3px 0;
      font-size: 17px;
      letter-spacing: 0.5px;
      font-weight: 700;
    }
    .content__top p {
      margin: 0;
      font-size: 13px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 12px;
    }
    table td {
      padding: 2px 4px;
    }

    /* MONEY TABLE */
    .content__money {
      margin-top: 18px;
      font-size: 12px;
    }
    .content__money-r1,
    .content__money-r2 {
      display: flex;
      width: 100%;
      border-bottom: 1px solid #000;
      padding: 4px 0;
    }
    .content__money-r2:last-child {
      border-bottom: none;
    }

    .m1 { width: 55%; }
    .m2, .m3, .m4 { width: 15%; text-align: center; }

    .content__grand {
      margin-top: 20px;
      font-size: 12px;
      line-height: 18px;
    }
    .content__grand p {
      margin: 4px 0;
    }
  </style>
</head>

<body>
  <div class="main">

    <!-- QR TOP RIGHT -->
    <img class="qr-image" src="<%= data.src %>" alt="" />

    <!-- NEW LOGO TOP LEFT -->
    <div class="logo logo__daman">
      <img src="/images1/Daman.jpg" alt="" />
    </div>

    <!-- PAGE BACKGROUND (VEHICLE / DATE) -->
    <div class="content__back">
      <% for(let i=0;i<18;i++){ %>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>&nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
      <% } %>
    </div>

    <!-- MAIN CONTENT -->
    <div class="content">

      <div class="content__top">
        <h3>GOVERNMENT OF DAMAN & DIU</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <table>
        <tr>
          <td>Registration No.</td>
          <td>: <b><%=data.vehicleNo%></b></td>
        </tr>
        <tr>
          <td>Receipt No.</td>
          <td>: <%=data.receiptNo%></td>
        </tr>
        <tr>
          <td>Payment Date</td>
          <td>: <%=data.paymentDate%></td>
        </tr>
        <tr>
          <td>Owner Name</td>
          <td>: <%=data.ownerName%></td>
        </tr>
        <tr>
          <td>Chassis No.</td>
          <td>: <%=data.chassisNo%></td>
          <td>Tax Mode</td>
          <td>: <%=data.taxMode%></td>
        </tr>
        <tr>
          <td>Vehicle Type</td>
          <td>: <%=data.vehiclePermitType%></td>
          <td>Vehicle Class</td>
          <td>: <%=data.vehicleClass%></td>
        </tr>
        <tr>
          <td>Mobile No.</td>
          <td>: <%=data.mobileNo%></td>
          <td>Checkpost Name</td>
          <td>: <%=data.borderBarrier%></td>
        </tr>

        <tr>
          <td>Sleeper Cap.</td>
          <td>: <%=data.sleeperCapacityExcludingDriver%></td>

          <% if(data.vehiclePermitType === 'GOODS VEHICLE'){ %>
            <td>Gross Weight</td>
            <td>: <%=data.grossVehicleWeight%> KG</td>
          <% } else { %>
            <td>Seating Cap (Ex. Driver)</td>
            <td>: <%=data.seatingCapacityExcludingDriver%></td>
          <% } %>
        </tr>

        <tr>
          <td>Bank Ref. No.</td>
          <td>: NA</td>
          <td>Payment Mode</td>
          <td>: <%=data.paymentMode%></td>
        </tr>

        <tr>
          <td>Service Type</td>
          <td>: NOT APPLICABLE</td>
        </tr>

        <tr>
          <td>Permit Type</td>
          <td>: <%=data.permitType%></td>
          <td>Permit Category</td>
          <td>:</td>
        </tr>
      </table>

      <!-- MONEY TABLE -->
      <div class="content__money">
        <div class="content__money-r1 d-flex">
          <div class="m1"><b>Particular</b></div>
          <div class="m2"><b>Fees/Tax</b></div>
          <div class="m3"><b>Fine</b></div>
          <div class="m4"><b>Total</b></div>
        </div>

        <div class="content__money-r2 d-flex">
          <div class="m1">MV Tax ( <%=data.taxFrom%> to <%=data.taxTo%> )</div>
          <div class="m2"><%=data.totalAmount%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.totalAmount%></div>
        </div>
      </div>

      <!-- GRAND TOTAL + NOTES -->
      <div class="content__grand">
        <p><b>Grand Total :</b> ₹ <%=data.totalAmount%>/- ( <%=data.totalAmountInWord%> )</p>

        <p><i>Note : 1) This is a computer generated printout and no signature is required.</i></p>

        <p><i>
          2) Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and defaulter shall be liable for penal action.
          <br /><br />
          you will also receive the payment confirmation message.
        </i></p>

        <p class="main__warning">
          Scan the QR code for genuinity of the receipt, It should land at <u>https://kms.privahan.gov.in</u>
        </p>

        <p class="main__warning main__warning-2">
          If the URL is different, then receipt could be a fake one, please raise a complain.
        </p>
      </div>

    </div>
  </div>
</body>
</html>
