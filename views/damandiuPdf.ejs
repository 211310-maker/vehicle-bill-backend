<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>DNH & DD - Tax Receipt</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <% if (data.cssFix) { %>
      <link rel="stylesheet" href="/css/cssFix.css" />
    <% } %>

    <style>
      * {
        box-sizing: border-box;
      }

      /* Same page width setup as Puducherry */
      @page {
        size: A4;
        margin: 0;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #fff;
        font-family: "Roboto", Arial, Helvetica, sans-serif;
        color: #000;
        font-size: 12px;
        width: 210mm;
      }

      .main {
        width: 210mm;
        margin: 0 auto;
        padding: 12mm 15mm;
        position: relative;
      }

      .content {
        position: relative;
        z-index: 2;
      }

      /* CENTERED WATERMARK */
      .watermark {
        position: absolute;
        top: 230px;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0.08;
        width: 280px;
        z-index: 1;
      }

      /* BACKGROUND VEHICLE / DATE TEXT (LEFT STRIP) */
      .content__back {
        position: absolute;
        top: 120px;
        left: 15mm;
        right: 15mm;
        bottom: 40mm;
        z-index: 0;
        opacity: 0.08;
        font-size: 11px;
        pointer-events: none;
      }

      .content__back p {
        margin: 0;
        line-height: 1.4;
        white-space: nowrap;
      }

      /* HEADER (logo + center text + QR) */
      .header {
        display: table;
        width: 100%;
        margin-bottom: 14px;
      }

      .header-cell {
        display: table-cell;
        vertical-align: top;
      }

      .header-logo {
        width: 22%;
      }

      .header-logo img {
        width: 90px;
        height: auto;
      }

      .header-center {
        width: 56%;
        text-align: center;
        line-height: 1.3;
      }

      .header-center .gov {
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
      }

      .header-center .dept {
        font-size: 12px;
        font-weight: 500;
      }

      .header-center .title {
        font-size: 12px;
        font-weight: 500;
      }

      .header-qr {
        width: 22%;
        text-align: right;
      }

      .header-qr img {
        width: 120px;
        height: 120px;
        object-fit: contain;
      }

      /* MAIN KV TABLE (4 fixed columns like Puducherry) */
      table.kv {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 6px;
        table-layout: fixed;
        font-size: 12px;
      }

      table.kv td {
        padding: 2px 2px;
        vertical-align: top;
      }

      table.kv td.label {
        font-weight: 600;
        white-space: nowrap;
      }

      table.kv td.value {
        font-weight: normal;
        padding-left: 2px;
        white-space: normal;
      }

      /* TAX TABLE (blue border like ref) */
      table.tax {
        width: 100%;
        border-collapse: collapse;
        margin-top: 14px;
        font-size: 11px;
      }

      table.tax th,
      table.tax td {
        border: 1px solid #0070c0;
        padding: 4px 6px;
      }

      table.tax th {
        text-align: center;
        font-weight: bold;
      }

      table.tax td {
        text-align: left;
      }

      table.tax td.num {
        text-align: right;
        width: 10%;
      }

      .grand-total {
        margin-top: 6px;
        font-size: 11px;
        font-weight: bold;
      }

      .note-title {
        margin-top: 8px;
        font-weight: bold;
        font-size: 11px;
      }

      .terms-title {
        margin-top: 2px;
        font-weight: bold;
        font-size: 11px;
      }

      .terms-body {
        margin: 0 0 0 16px;
        font-size: 11px;
      }

      .terms-body p {
        margin: 1px 0;
      }

      .bottom-note {
        margin-top: 10px;
        font-size: 12px;
        font-weight: bold;
      }

      .bottom-note a {
        color: #0070c0;
        text-decoration: underline;
      }

      @media print {
        a[href]:after {
          content: "" !important; /* don't print URL next to links */
        }
      }
    </style>
  </head>

  <body>
    <div class="main">
      <!-- BIG CENTER WATERMARK -->
      <img src="/images1/Daman.jpg" class="watermark" alt="Watermark" />

      <!-- BACKGROUND VEHICLE / DATE TEXT -->
      <div class="content__back">
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
        <p><span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span></p>
      </div>

      <div class="content">
        <!-- HEADER -->
        <div class="header">
          <div class="header-cell header-logo">
            <img src="/images1/Daman.jpg" alt="Logo" />
          </div>

          <div class="header-cell header-center">
            <div class="gov">GOVERNMENT OF UT OF DNH and DD</div>
            <div class="dept">Department of Transport</div>
            <div class="title">Checkpost Tax e-Receipt</div>
          </div>

          <div class="header-cell header-qr">
            <% if (data.src) { %>
              <img src="<%= data.src %>" alt="QR Code" />
            <% } %>
          </div>
        </div>

        <!-- MAIN DETAILS -->
        <table class="kv">
          <colgroup>
            <col style="width:22%">
            <col style="width:28%">
            <col style="width:22%">
            <col style="width:28%">
          </colgroup>

          <tr>
            <td class="label">Registration No.</td>
            <td class="value">: <b><%= data.vehicleNo || '' %></b></td>
            <td class="label">Receipt No.</td>
            <td class="value">: <%= data.receiptNo || '' %></td>
          </tr>

          <tr>
            <td class="label">Payment Date</td>
            <td class="value">: <%= data.paymentDate || '' %></td>
            <td class="label">Owner Name.</td>
            <td class="value">: <%= data.ownerName || '' %></td>
          </tr>

          <tr>
            <td class="label">Chassis No.</td>
            <td class="value">: <%= data.chassisNo || '' %></td>
            <td class="label">Tax Mode</td>
            <td class="value">: <%= data.taxMode || '' %></td>
          </tr>

          <tr>
            <td class="label">Vehicle Type</td>
            <td class="value">: <%= data.vehiclePermitType || '' %></td>
            <td class="label">Vehicle Class</td>
            <td class="value">: <%= data.vehicleClass || '' %></td>
          </tr>

          <tr>
            <td class="label">Vehicle Category</td>
            <td class="value">: <%= data.vehicleCategory || '' %></td>
            <td class="label">Mobile No.</td>
            <td class="value">: <%= data.mobileNo || '' %></td>
          </tr>

          <tr>
            <td class="label">CheckPost Name</td>
            <td class="value">: <%= data.borderBarrier || '' %></td>
            <td class="label">Seating Capacity</td>
            <td class="value">
              : <%= data.seatingCapacityExcludingDriver || data.seatingCapacity || '' %>
            </td>
          </tr>

          <tr>
            <td class="label">Sleeper Cap.</td>
            <td class="value">
              : <%= data.sleeperCapacityExcludingDriver || data.sleeperCap || '' %>
            </td>
            <td class="label">Bank Ref. No.</td>
            <td class="value">
              : <%= data.bankRefNo || 'NA' %>
            </td>
          </tr>

          <tr>
            <td class="label">Payment Mode</td>
            <td class="value">: <%= data.paymentMode || '' %></td>
            <td class="label">Service Type</td>
            <td class="value">: <%= data.serviceType || 'NOT APPLICABLE' %></td>
          </tr>

          <tr>
            <td class="label">Permit Type</td>
            <td class="value">: <%= data.permitType || '' %></td>
            <td class="label">Permit Category</td>
            <td class="value">:</td>
          </tr>
        </table>

        <!-- TAX TABLE -->
        <table class="tax">
          <thead>
            <tr>
              <th>Tax/Fee Particular</th>
              <th>Tax/Fees</th>
              <th>Fine</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                MV Tax ( <%= data.taxFrom || '' %> To <%= data.taxTo || '' %> )
              </td>
              <td class="num"><%= data.totalAmount || 0 %></td>
              <td class="num">0</td>
              <td class="num"><%= data.totalAmount || 0 %></td>
            </tr>
          </tbody>
        </table>

        <div class="grand-total">
          Grand Total : <%= data.totalAmount || 0 %>/- <%= data.totalAmountInWord || '' %> Only
        </div>

        <div class="note-title">Note :</div>
        <div class="terms-title">Terms and Conditions:</div>
        <div class="terms-body">
          <p>1) This is a computer generated printout and no signature is required.</p>
          <p>2) Should not carry unlawful/unaccompanied goods.</p>
          <p>
            3) If any false information/discrepancies are found at later, necessary action will be
            taken against the vehicle owner/driver.
          </p>
        </div>

        <div class="bottom-note">
          Scan the QR code for genuinity of the receipt, It should land at
          <a>https://kms.parivahan.gov.in</a> site. In case the URL is different, then receipt
          could be a fake one, please raise a complain.
        </div>
      </div>
    </div>
  </body>
</html>
