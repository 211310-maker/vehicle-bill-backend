<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Daman & Diu - Tax Receipt</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    /* ===== PRINT SETUP ===== */
    @page {
      size: A4;
      margin: 0;
    }

    body {
      margin: 0;
      padding: 0;
      background: #fff;
      font-family: "Roboto", Arial, Helvetica, sans-serif;
      color: #000;
      font-size: 12px;
    }

    /* ===== CENTER PAGE IN BROWSER (CRITICAL FIX) ===== */
    .page {
      width: 100vw;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      background: #fff;
    }

    /* ===== A4 PAGE ===== */
    .main {
      width: 210mm;
      min-height: 297mm;
      padding: 12mm 15mm;
      position: relative;
      background: #fff;
    }

    .content {
      position: relative;
      z-index: 3;
    }

    /* ===== CENTER WATERMARK ===== */
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 300px;
      opacity: 0.07;
      z-index: 1;
      pointer-events: none;
    }

    /* ===== BACKGROUND VEHICLE / DATE TEXT ===== */
    .bg-repeat {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0.08;
      font-size: 15px;
      line-height: 1.3;
      pointer-events: none;
    }

    .bg-repeat p {
      margin: 0;
      padding-left: 10px;
      white-space: nowrap;
      font-weight: 500;
    }

    /* ===== HEADER ===== */
    .header {
      display: table;
      width: 100%;
      margin-bottom: 14px;
    }

    .header-cell {
      display: table-cell;
      vertical-align: top;
    }

    .header-logo {
      width: 22%;
    }

    .header-logo img {
      width: 85px;
    }

    .header-center {
      width: 56%;
      text-align: center;
      line-height: 1.4;
    }

    .header-center .gov {
      font-size: 15px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .header-center .dept {
      font-size: 13px;
      font-weight: 600;
    }

    .header-center .title {
      font-size: 13px;
      font-weight: 600;
    }

    .header-qr {
      width: 22%;
      text-align: right;
    }

    .header-qr img {
      width: 120px;
      height: 120px;
    }

    /* ===== DETAILS TABLE ===== */
    table.details {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
    }

    table.details td {
      padding: 3px 2px;
      vertical-align: top;
    }

    table.details td.label {
      white-space: nowrap;
    }

    table.details td.value {
      font-weight: 700;
      padding-left: 2px;
    }

    /* ===== TAX TABLE ===== */
    .money {
      margin-top: 14px;
      font-size: 12.5px;
    }

    .money-header,
    .money-row {
      display: table;
      width: 100%;
      border-collapse: collapse;
    }

    .money-header div,
    .money-row div {
      display: table-cell;
      border: 1px solid #0070c0;
      padding: 4px 6px;
    }

    .money-header {
      font-weight: 700;
      text-align: center;
    }

    .money-row .m1 {
      width: 60%;
    }

    .money-row .m2,
    .money-row .m3,
    .money-row .m4 {
      width: 13.33%;
      text-align: right;
    }

    /* ===== GRAND TOTAL & NOTES ===== */
    .grand {
      margin-top: 10px;
      font-size: 12.5px;
    }

    .grand b {
      font-weight: 800;
    }

    .terms-title {
      font-weight: 700;
      margin-top: 4px;
    }

    .terms-list {
      margin-left: 16px;
      padding: 0;
    }

    .terms-list li {
      margin-bottom: 2px;
    }

    .bottom-note {
      margin-top: 10px;
      font-size: 12.5px;
      font-weight: 700;
    }

    .bottom-note a {
      color: #0070c0;
      text-decoration: underline;
    }

    /* REMOVE URL TEXT IN PRINT */
    @media print {
      a[href]:after {
        content: "" !important;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="main">

      <!-- WATERMARK -->
      <img src="<%= data.host %>/images1/Daman.jpg" class="watermark" />

      <!-- BACKGROUND TEXT -->
      <div class="bg-repeat">
        <% for (let i = 0; i < 22; i++) { %>
          <p><%= data.vehicleNo %> / <%= data.paymentDate %></p>
        <% } %>
      </div>

      <div class="content">
        <!-- HEADER -->
        <div class="header">
          <div class="header-cell header-logo">
            <img src="<%= data.host %>/images1/Daman.jpg" />
          </div>

          <div class="header-cell header-center">
            <div class="gov">GOVERNMENT OF DAMAN & DIU</div>
            <div class="dept">Department of Transport</div>
            <div class="title">Checkpost Tax e-Receipt</div>
          </div>

          <div class="header-cell header-qr">
            <img src="<%= data.src %>" />
          </div>
        </div>

        <!-- DETAILS -->
        <table class="details">
          <tr>
            <td class="label">Registration No.</td>
            <td class="value">: <%= data.vehicleNo %></td>
            <td class="label">Receipt No.</td>
            <td class="value">: <%= data.receiptNo %></td>
          </tr>
          <tr>
            <td class="label">Payment Date</td>
            <td class="value">: <%= data.paymentDate %></td>
            <td class="label">Owner Name</td>
            <td class="value">: <%= data.ownerName %></td>
          </tr>
          <tr>
            <td class="label">Chassis No.</td>
            <td class="value">: <%= data.chassisNo %></td>
            <td class="label">Tax Mode</td>
            <td class="value">: <%= data.taxMode %></td>
          </tr>
          <tr>
            <td class="label">Vehicle Type</td>
            <td class="value">: <%= data.vehiclePermitType %></td>
            <td class="label">Vehicle Class</td>
            <td class="value">: <%= data.vehicleClass %></td>
          </tr>
          <tr>
            <td class="label">Mobile No.</td>
            <td class="value">: <%= data.mobileNo %></td>
            <td class="label">Checkpost Name</td>
            <td class="value">: <%= data.borderBarrier %></td>
          </tr>
        </table>

        <!-- TAX -->
        <div class="money">
          <div class="money-header">
            <div>Tax/Fee Particular</div>
            <div>Tax/Fees</div>
            <div>Fine</div>
            <div>Total</div>
          </div>
          <div class="money-row">
            <div class="m1">
              MV Tax ( <%= data.taxFrom %> to <%= data.taxTo %> )
            </div>
            <div class="m2"><%= data.totalAmount %></div>
            <div class="m3">0</div>
            <div class="m4"><%= data.totalAmount %></div>
          </div>
        </div>

        <!-- GRAND TOTAL -->
        <div class="grand">
          <b>
            Grand Total : ₹ <%= data.totalAmount %> /-
            ( <%= data.totalAmountInWord %> )
          </b>

          <p class="terms-title">Terms and Conditions:</p>
          <ol class="terms-list">
            <li>This is a computer generated printout and no signature is required.</li>
            <li>Incorrect mentioning of vehicle class or seating capacity may lead to penal action.</li>
          </ol>

          <div class="bottom-note">
            Scan the QR code for genuinity of the receipt, It should land at
            <a href="https://kms.parivahan.gov.in">https://kms.parivahan.gov.in</a>
            site.
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
