<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Roboto', sans-serif;
    }

    .main {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      position: relative;
      padding: 20px 30px;
    }

    /* TOP LEFT LOGO (ODISHA EMBLEM) */
    .top-left-logo {
      position: absolute;
      top: 10px;
      left: 20px;
      width: 95px;
      height: auto;
      z-index: 10;
    }

    /* QR CODE TOP RIGHT */
    .qr-image-od {
      position: absolute;
      top: 10px;
      right: 20px;
      width: 120px;
      height: 120px;
      object-fit: contain;
      z-index: 10;
    }

    /* WATERMARK IN CENTER */
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.13;  /* more visible */
      z-index: 1;
      pointer-events: none;
    }

    .watermark img {
      width: 55%;
      opacity: 0.13;
    }

    /* CONTENT OVER THE WATERMARK */
    .content {
      position: relative;
      z-index: 5;
      margin-top: 120px; /* ensures no overlap with top logos */
      text-align: center;
    }

    .content h3,
    .content p {
      margin: 3px 0;
    }

    /* TABLE ALIGNMENT */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      margin-top: 15px;
    }

    td {
      padding: 4px 6px;
    }

    /* MONEY TABLE */
    .content__money {
      margin-top: 20px;
    }

    .content__money-r1,
    .content__money-r2 {
      display: flex;
      width: 100%;
      border-bottom: 1px solid #000;
      padding: 5px 0;
    }

    .m1,
    .m2,
    .m3,
    .m4 {
      width: 25%;
      text-align: left;
    }

    .content__grand {
      margin-top: 25px;
      font-size: 15px;
    }

    .container_signature {
      text-align: right;
      margin-top: 40px;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <div class="main">

    <!-- LEFT TOP LOGO -->
    <img class="top-left-logo" src="<%=data.host%>/images1/Odisha.png" alt="logo" />

    <!-- QR CODE RIGHT TOP -->
    <img class="qr-image-od" src="<%= data.src %>" alt="QR" />

    <!-- WATERMARK -->
    <div class="watermark">
      <img src="<%=data.host%>/images1/Odisha.png" />
    </div>

    <div class="content">
      <h3>GOVERMENT OF ODISHA</h3>
      <p>Odisha Motor Vehicles Department</p>
      <p><b>Checkpost Tax e-Receipt</b></p>

      <h3 style="margin-top:10px;">Receipt No. : ORT<%=data.receiptNo%></h3>

      <!-- DETAILS TABLE -->
      <table>
        <tr>
          <td>Vehicle No.</td>
          <td>: <%=data.vehicleNo%></td>
          <td>Payment Date</td>
          <td>: <%=data.paymentDate%></td>
        </tr>
        <tr>
          <td>Owner Name</td>
          <td>: <%=data.ownerName%></td>
          <td>Mobile No.</td>
          <td>: <%=data.mobileNo%></td>
        </tr>
        <tr>
          <td>Chassis No.</td>
          <td>: <%=data.chassisNo%></td>
          <td>Tax Mode</td>
          <td>: <%=data.taxMode%></td>
        </tr>
        <tr>
          <td>Vehicle Type</td>
          <td>: <%=data.vehiclePermitType%></td>
          <td>Vehicle Class</td>
          <td>: <%=data.vehicleClass%></td>
        </tr>

        <% if(data.vehiclePermitType==='GOODS VEHICLE' ){ %>
        <tr>
          <td>Laden Weight</td>
          <td>: <%=data.grossVehicleWeight%> Kg</td>
          <td>Un Laden Weight</td>
          <td>: <%=data.unladenWeight%> kg</td>
        </tr>
        <% } else { %>
        <tr>
          <td>Seating Capacity</td>
          <td>: <%=data.seatingCapacityExcludingDriver%></td>
          <td>Sleeper Cap.</td>
          <td>: <%=data.sleeperCapacityExcludingDriver%></td>
        </tr>
        <% } %>

        <tr>
          <td>Standing Capacity</td>
          <td>: 0</td>
          <td>Bank Ref No.</td>
          <td>: <%=data.rjBankRefNo%></td>
        </tr>

        <tr>
          <td>Payment Mode</td>
          <td>: <%=data.paymentMode%></td>
          <td>Payment Status</td>
          <td>: SUCCESS</td>
        </tr>
      </table>

      <!-- MONEY TABLE -->
      <div class="content__money">
        <div class="content__money-r1">
          <div class="m1"><b>Particular</b></div>
          <div class="m2"><b>Fees/Tax</b></div>
          <div class="m3"><b>Fine</b></div>
          <div class="m4"><b>Total</b></div>
        </div>

        <div class="content__money-r2">
          <div class="m1">MV Tax( <%=data.taxFrom_od%> to <%=data.taxTo_od%> )</div>
          <div class="m2"><%=data.mvTax%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.mvTax%></div>
        </div>

        <div class="content__money-r2">
          <div class="m1">Application Fee</div>
          <div class="m2"><%=data.applicationFee%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.applicationFee%></div>
        </div>

        <div class="content__money-r2">
          <div class="m1">Permit Fee</div>
          <div class="m2"><%=data.permitFee%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.permitFee%></div>
        </div>
      </div>

      <!-- GRAND TOTAL -->
      <div class="content__grand">
        <p>
          <b>Grand Total : ₹ <%=data.totalAmount%>/- ( <%=data.totalAmountInWord%> )</b>
        </p>
      </div>

      <!-- PERMIT SECTION -->
      <h4><b>FORM XXVI</b></h4>
      <h4><b>See Rule 46(1)(v)</b></h4>
      <h4><b>TEMP. PERMIT No.: ORT<%=data.receiptNo%></b></h4>

      <table>
        <tr>
          <td>1. Name of Holder</td>
          <td>: <%=data.ownerName%></td>
        </tr>
        <tr>
          <td>2. Area</td>
          <td>: <%=data.floorArea%></td>
        </tr>
        <tr>
          <td>3. (i) Type of vehicle</td>
          <td>: <%=data.vehicleClass%></td>
        </tr>
        <tr>
          <td>&nbsp;&nbsp;&nbsp;(ii) Registration Mark</td>
          <td>: <%=data.vehicleNo%></td>
        </tr>
        <tr>
          <td>&nbsp;&nbsp;&nbsp;(iii) Seating Capacity</td>
          <td>: <%=data.seatingCapacityExcludingDriver%></td>
        </tr>
        <tr>
          <td>&nbsp;&nbsp;&nbsp;(iv) Gross Vehicle Weight</td>
          <td>: <%=data.grossVehicleWeight%></td>
        </tr>
        <tr>
          <td>4. Purpose of Journey</td>
          <td>: <%=data.purposeOfJourney%></td>
        </tr>
        <tr>
          <td>5. Nature of goods</td>
          <td>: </td>
        </tr>
        <tr>
          <td>6. Date of expiry</td>
          <td>: <%=data.permitValidity%></td>
        </tr>
        <tr>
          <td>7. Valid in following regions</td>
          <td>: (1) _____________ (2) _____________ (3) _____________ (4) _____________</td>
        </tr>
        <tr>
          <td>8. Route</td>
          <td>: <%=data.routeOfTheJourney%></td>
        </tr>
      </table>

      <div class="container_signature">
        Secretary<br />
        State Transport Authority, ODISHA
      </div>

      <p><i>Note: 1) This is a computer generated printout and no signature is required</i></p>
      <p><i>2) Incorrect details may lead to penal action.</i></p>
      <p><i>3) Permit valid for one round trip only.</i></p>
      <p><i>4) Must accompany the Checkpost e-Receipt with QR code.</i></p>

    </div>
  </div>

</body>

</html>
