<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="<%=data.host%>/css/style.css" />
  <% if(data.cssFix){ %>
    <link rel="stylesheet" href="<%=data.host%>/css/cssFix.css" />
  <% } %>

  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
    }

    .main {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 30px;
      box-sizing: border-box;
    }

    /* QR TOP RIGHT */
    .main .qr-image-od {
      position: absolute;
      top: 20px;
      right: 35px !important;
      width: 140px;
      height: 140px;
      object-fit: contain;
      z-index: 10;
    }

    /* FIXED — TOP-LEFT LOGO, MOVED RIGHT */
    .main .logo.logo__od {
      position: absolute;
      top: 20px;
      left: 95px !important;   /* <-- moved further right */
      z-index: 10;
    }

    .main .logo.logo__od img {
      width: 155px;  /* slightly larger */
      height: auto;
      display: block;
    }

    /* FIXED WATERMARK — EXACT CENTER & BIGGER */
    .main .logo_od_main {
      position: absolute;
      top: 50%; 
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.17;        /* slightly more visible */
      z-index: 1;
      pointer-events: none;
    }

    .main .logo_od_main img {
      width: 520px !important;  /* <-- bigger watermark */
      max-width: 520px !important;
      height: auto;
    }

    /* ENSURE CONTENT APPEARS ABOVE WATERMARK */
    .content,
    .content__grand,
    .content__top,
    .content__top_receiptNoOD,
    .main table {
      position: relative;
      z-index: 5;
    }

    .content {
      margin-top: 110px; /* pushes text below QR and logo */
    }

    .content__top {
      text-align: center;
    }
  </style>
</head>

<body>
  <div class="main">

    <!-- QR -->
    <img class="qr-image-od" src="<%= data.src %>" alt="" />

    <!-- TOP LEFT LOGO -->
    <div class="logo logo__od">
      <img src="<%=data.host%>/images1/Odisha.png" alt="" />
    </div>

    <!-- WATERMARK -->
    <div class="main__printing logo_od_main">
      <img src="<%=data.host%>/images1/Odisha.png" alt="" />
    </div>

    <div class="content">
      <div class="content__top">
        <h3 class="content__heading">GOVERMENT OF ODISHA</h3>
        <p class="content__title content__heading_kat">Odisha Motor Vehicles Department</p>
        <p class="content__desc">Checkpost Tax e-Receipt</p>
      </div>

      <div class="content__top_receiptNoOD">
        <h3 class="content__title">
          Receipt No. : ORT<%=data.receiptNo%>
        </h3>
      </div>

      <!-- TABLE CONTENT -->
      <table class="rj kat mr">
        <tr class="r1 r11">
          <td class="r1-1-od">Vehicle No.</td>
          <td class="r1-2">: <%=data.vehicleNo%></td>
          <td class="r1-3">Payment Date</td>
          <td class="r1-4">: <%=data.paymentDate%></td>
        </tr>

        <tr class="r1 r14">
          <td class="r1-1-od">Owner Name</td>
          <td class="r1-2">: <%=data.ownerName%></td>
          <td class="r1-3">Mobile No.</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.mobileNo%></td>
        </tr>

        <tr class="r1 r15">
          <td class="r1-1-od">Chassis No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
          <td class="r1-3">Tax Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.taxMode%></td>
        </tr>

        <tr class="r1">
          <td class="r1-1-od">Vehicle Type</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.vehiclePermitType%></td>
          <td class="r1-3">Vehicle Class</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleClass%></td>
        </tr>

        <% if(data.vehiclePermitType==='GOODS VEHICLE'){ %>
        <tr class="r1">
          <td class="r1-1-od">Laden Weight</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.grossVehicleWeight%> Kg</td>
          <td class="r1-3">Un Laden Weight</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.unladenWeight%> kg</td>
        </tr>
        <% } else { %>
        <tr class="r1">
          <td class="r1-3">Seating Cap (Ex. Driver)</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%></td>
          <td class="r1-1-od">Sleeper Cap.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%></td>
        </tr>
        <% } %>

        <tr class="r1">
          <td>Standing Capacity</td>
          <td>&nbsp;&nbsp;: 0</td>
          <td class="r1-1-od">Bank Ref No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.rjBankRefNo%></td>
        </tr>

        <tr class="r1">
          <td class="r1-3">Payment Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentMode%></td>
          <td class="r1-3">Payment Status</td>
          <td class="r1-4">&nbsp;&nbsp;: SUCCESS</td>
        </tr>

      </table>

      <!-- MONEY SECTION -->
      <div class="content__money content__money_od">
        <div class="content__money-r1 d-flex">
          <div class="m1"><b>Particular</b></div>
          <div class="m2"><b>Fees/Tax</b></div>
          <div class="m3"><b>Fine</b></div>
          <div class="m4"><b>Total</b></div>
        </div>

        <% /* SAME LOGIC as original */ %>

        <div class="content__money-r2 content__money-r2-border d-flex odr">
          <div class="m1">MV Tax ( <%=data.taxFrom_od%> to <%=data.taxTo_od%> )</div>
          <div class="m2"><%=data.mvTax%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.mvTax%></div>
        </div>

        <div class="content__money-r2 content__money-r2-border d-flex odr">
          <div class="m1">Application Fee</div>
          <div class="m2"><%=data.applicationFee%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.applicationFee%></div>
        </div>

        <div class="content__money-r2 d-flex odr content__money-r2-border">
          <div class="m1">Permit Fee</div>
          <div class="m2"><%=data.permitFee%></div>
          <div class="m3">0</div>
          <div class="m4"><%=data.permitFee%></div>
        </div>

      </div>

      <div class="content__grand content__grand--hr">
        <p>
          <b>Grand Total : ₹ <%=data.totalAmount%>/- ( <%=data.totalAmountInWord%> )</b>
        </p>
      </div>

      <!-- PERMIT SECTION SAME AS ORIGINAL -->
      <div class="container">
        <h4><b>FORM XXVI</b></h4>
        <h4><b>See Rule 46(1)(v)</b></h4>
        <h4><b>TEMP. PERMIT No.: ORT<%=data.receiptNo%></b></h4>
      </div>

      <!-- ... rest unchanged ... -->

    </div>
  </div>
</body>

</html>
