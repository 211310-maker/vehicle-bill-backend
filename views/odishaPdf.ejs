<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="<%=data.host%>/css/style.css" />
  <% if(data.cssFix){ %>
    <link rel="stylesheet" href="<%=data.host%>/css/cssFix.css" />
  <% } %>

  <!-- overrides for QR top-right, logo top-left, watermark center-right -->
  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
    }

    .main {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 30px;
      box-sizing: border-box;
    }

    /* QR top-right of page */
    .qr-image-od {
      position: absolute;
      top: 20px;
      right: 30px;
      width: 140px;
      height: 140px;
      object-fit: contain;
      z-index: 10;
    }

    /* LOGO top-left of page */
    .logo__od {
      position: absolute;
      top: 20px;
      left: 60px;
      z-index: 10;
    }

    .logo__od img {
      width: 150px;
      height: auto;
      display: block;
    }

    /* WATERMARK (Odisha.png) in exact center */
    .logo_od_main {
      position: absolute;
      top: 50%;          /* center vertically */
      left: 50%;         /* center horizontally */
      transform: translate(-50%, -50%);
      opacity: 0.16;     /* a bit more visible */
      z-index: 1;
      pointer-events: none;
}

     .logo_od_main img {
       width: 70%;        /* make it bigger (try 70–80%) */
       max-width: 450px;  /* optional hard cap */
       height: auto;
}

    /* Make sure actual content is above watermark */
    .content,
    .content__grand,
    .content__top,
    .content__top_receiptNoOD,
    .main table {
      position: relative;
      z-index: 5;
    }

    /* Space so text starts below logo/QR */
    .content {
      margin-top: 90px;
    }

    .content__top {
      text-align: center;
    }
  </style>
</head>

<body>
  <div class="main">
    <!-- QR CODE TOP RIGHT -->
    <img class="qr-image-od" src="<%= data.src %>" alt="" />

    <!-- LOGO TOP LEFT -->
    <div class="logo logo__od">
      <img src="<%=data.host%>/images1/Odisha.png" alt="" />
    </div>

    <!-- WATERMARK -->
    <div class="main__printing logo_od_main">
      <img src="<%=data.host%>/images1/Odisha.png" alt="" />
    </div>

    <div class="content">
      <div class="content__top">
        <h3 class="content__heading">GOVERMENT OF ODISHA</h3>
        <p class="content__title content__heading_kat">Odisha Motor Vehicles Department</p>
        <p class="content__desc">Checkpost Tax e-Receipt</p>
      </div>
      <div class="content__top_receiptNoOD">
        <h3 class="content__title"> Receipt No. : ORT<%=data.receiptNo%></h3>
      </div>

      <table class="rj kat mr">
        <tr class="r1 r11">
          <td class="r1-1-od">Vehicle No.</td>
          <td class="r1-2">: <%=data.vehicleNo%></td>
          <td class="r1-3">Payment Date</td>
          <td class="r1-4">: <%=data.paymentDate%></td>
        </tr>
        <!-- <tr class="r1 r12">
            <td class="r1-1-od">Receipt No.</td>
            <td class="r1-2">: <%=data.receiptNo%></td>
          </tr> -->
        <tr class="r1 r14">
          <td class="r1-1-od">Owner Name</td>
          <td class="r1-2">: <%=data.ownerName%></td>
          <td class="r1-3">Mobile No.</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.mobileNo%></td>
        </tr>
        <tr class="r1 r15">
          <td class="r1-1-od">Chassis No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
          <td class="r1-3">Tax Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.taxMode%></td>
        </tr>
        <tr class="r1">
          <td class="r1-1-od">Vehicle Type</td>
          <td class="r1-2"> &nbsp;&nbsp;: <%=data.vehiclePermitType%></td>
          <td class="r1-3">Vehicle Class</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleClass%></td>
        </tr>
        <!-- <tr class="r1">
            <td class="r1-1-od">Permit Type</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.permitType%></td>
            <td class="r1-3">Floor Area</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.floorArea%></td>
          </tr> -->
        <% if(data.vehiclePermitType==='GOODS VEHICLE' ){ %>
          <tr class="r1">
            <td class="r1-1-od">Laden Weight</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.grossVehicleWeight%> Kg</td>
            <td class="r1-3">Un Laden Weight</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.unladenWeight%> kg</td>
          </tr>
        <% } else { %>
          <tr class="r1">
            <td class="r1-3">
              Seating Cap(Ex. <br />
              Driver
            </td>
            <td class="r1-4">
              &nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%>
            </td>
            <td class="r1-1-od">Sleeper Cap.</td>
            <td class="r1-2">
              &nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%>
            </td>
          </tr>
        <% } %>
        <!-- <tr class="r1">
                <td class="r1-1-od">Permit Validity</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.permitUpto%>
                </td>
                <td class="r1-1-od">Fitness Validity</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.fitnessValidity%>
                </td>
              </tr> -->
        <!-- <tr class="r1">
                <td class="r1-1-od">Insurance Validity</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.insuranceValidity%>
                </td>
                <td class="r1-1-od">Tax Validity</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.fitnessValidity%>
                </td>
              </tr> -->
        <tr class="r1">
          <td>Standing Capacity</td>
          <td>&nbsp;&nbsp;: 0</td>
          <td class="r1-1-od">Bank Ref No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.rjBankRefNo%></td>
        </tr>
        <tr class="r1">
          <td class="r1-3">Payment Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentMode%></td>
          <td class="r1-3">Payment Status</td>
          <td class="r1-4">&nbsp;&nbsp;: SUCCESS</td>
        </tr>
      </table>

      <div class="content__money content__money_od">
        <div class="content__money-r1 d-flex">
          <div class="m1"><b>Particular</b></div>
          <div class="m2"><b>Fees/Tax</b></div>
          <div class="m3"><b>Fine</b></div>
          <div class="m4"><b>Total</b></div>
        </div>
        <% if ((data.vehiclePermitType==="CONSTRUCTION EQUIPMENT VEHICLE" && data.permitType==="NOT APPLICABLE" ) ||
          (data.vehiclePermitType==="CONTRACT CARRIAGE/PASSANGER VEHICLES" && data.permitType==="TOURIST PERMIT" ) ||
          (data.vehiclePermitType==="GOODS VEHICLE" && data.permitType==="NATIONAL PERMIT" )){ %>
          <div class="content__money-r2 content__money-r2-border d-flex odr">
            <div class="m1">
              MV Tax( <%=data.taxFrom_od%> to <%=data.taxTo_od%> )
            </div>
            <div class="m2">
              <%=data.mvTax%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.mvTax%>
            </div>
          </div>
          <div class="content__money-r2 content__money-r2-border d-flex odr">
            <div class="m1">
              Application Fee
            </div>
            <div class="m2">
              <%=data.applicationFee%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.applicationFee%>
            </div>
          </div>
          <div class="content__money-r2 d-flex odr content__money-r2-border">
            <div class="m1">Permit Fee</div>
            <div class="m2">
              <%=data.permitFee%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.permitFee%>
            </div>
          </div>
        <% } else { %>
          <div class="content__money-r2 content__money-r2-border d-flex odr">
            <div class="m1">
              MV Tax( <%=data.taxFrom_od%> to <%=data.taxTo_od%> )
            </div>
            <div class="m2">
              <%=data.mvTax%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.mvTax%>
            </div>
          </div>
          <div class="content__money-r2 content__money-r2-border d-flex odr">
            <div class="m1">
              Application Fee
            </div>
            <div class="m2">
              <%=data.applicationFee%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.applicationFee%>
            </div>
          </div>
          <div class="content__money-r2 d-flex odr content__money-r2-border">
            <div class="m1">Permit Fee</div>
            <div class="m2">
              <%=data.permitFee%>
            </div>
            <div class="m3">0</div>
            <div class="m4">
              <%=data.permitFee%>
            </div>
          </div>
        <% } %>
      </div>

      <div class="content__grand content__grand--hr">
        <p>
          <b><span>Grand Total :</span> ₹ <%=data.totalAmount%>/- (
              <%=data.totalAmountInWord%> )
          </b>
        </p>
        <div class="container">
          <h4 class="content__title">
            <b>FORM XXVI </b>
          </h4>
          <h4 class="content__title">
            <b>See Rule 46(1)(v)</b>
          </h4>
          <h4 class="content__title">
            <b><span>TEMP. PERMIT No.:</span> ORT<%=data.receiptNo%></b>
          </h4>
        </div>
        <table class="od">
          <tr class="r1 r11">
            <td class="r1-1-od1">1. Name of Holder</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.ownerName%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">2. Area</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.floorArea%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">3. (i) Type of vehicle</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.vehicleClass%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">&nbsp;&nbsp;&nbsp; (ii) Registration Mark</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.vehicleNo%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">&nbsp;&nbsp;&nbsp; (iii) Seating Capacity </td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.seatingCapacityExcludingDriver%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">&nbsp;&nbsp;&nbsp; (iv) Gross Vehicle Weight</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.grossVehicleWeight%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">4. Purpose of Journey or Jounerys</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.purposeOfJourney%></td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">5. Nature of goods if to be carried </td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;</td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">6. Date of expiry </td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.permitValidity%></td>
          </tr>
          <tr class="r1 r11">
            <td colspan="3" class="od_td">
              <div class="container_simple">
                <p>7. Under the provisions of Sub-section(4)of Sec 63 of the Act and with the particular general
                  consent </p>
                <p>&nbsp;&nbsp;&nbsp;&nbsp;of the Transport Authority concerned, this</p>
                <p>&nbsp;&nbsp;&nbsp;&nbsp;Permit is valid also in the following regions:
                <p>&nbsp;&nbsp;&nbsp;&nbsp;(1) ____________________(2) ____________________(3) ____________________(4)
                  ____________________</p>
              </div>
            </td>
          </tr>
          <tr class="r1 r11">
            <td class="r1-1-od1">8. Route or Routes</td>
            <td class="r1-2od"></td>
            <td class="r1-3">: &nbsp;&nbsp;<%=data.routeOfTheJourney%></td>
          </tr>
        </table>

        <div class="container_signature">
          <p>Secretary</p>
          <p>State Transport Authority, ODISHA</p>
        </div>

      </div>
      <div class="content__grand content__grand--hr">
        <p>
          <i>Note : 1) This is a computer generated printout and no signature is required</i>
        </p>
        <p>
          <i>
            2) Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and defaulter shall be
            liable for penal action.
          </i>
        </p>
        <p>
          <i>
            3) You are not allowed to make any intrastate trip within Orisha and this permit is valid for one round trip
            only.
          </i>
        </p>
        <p>
          <i>
            4) The Temporary Permit should be accompanied by the Checkpost e-Receipt with QR code.
            <br />
            you will also receive the payment confirmation message.
          </i>
        </p>
      </div>
    </div>
  </div>
</body>

</html>
