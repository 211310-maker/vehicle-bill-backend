<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* PAGE & PRINT SETUP */
      @page {
        size: A4;
        margin: 0;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
        font-size: 11px;              /* 🔴 smaller like govt PDF */
        line-height: 1.2;
        color: #000;
      }

      .main {
        position: relative;
        width: 100%;
        padding: 18px 30px 30px 30px; /* 🔴 tighter */
        box-sizing: border-box;
      }

      /* QR TOP-RIGHT */
      .qr-image-as {
        position: absolute;
        top: 18px;
        right: 30px;
        width: 120px;
        height: 120px;
        z-index: 10;
      }

      /* SMALL LOGO TOP-LEFT */
      .logo_as {
        position: absolute;
        top: 18px;
        left: 30px;
        z-index: 10;
      }

      .logo_as img {
        width: 95px;
        display: block;
      }

      /* BIG WATERMARK (CENTER) */
      .logo_as_main {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.07;               /* 🔴 lighter */
        z-index: 1;
        pointer-events: none;
      }

      .logo_as_main img {
        width: 330px;
      }

      /* BACKGROUND REPEATED TEXT */
      .content__back {
        position: absolute;
        top: 88px;
        left: 30px;
        right: 30px;
        bottom: 120px;
        z-index: 2;
        opacity: 0.12;
        pointer-events: none;
        font-size: 10px;
        line-height: 1.3;
        white-space: nowrap;
      }

      .content__back p {
        margin: 0;
      }

      /* HEADER */
      .as-header {
        position: absolute;
        top: 32px;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 5;
      }

      .as-header h3 {
        margin: 0;
        font-size: 14px;             /* 🔴 reduced */
        font-weight: 700;
      }

      .as-header p {
        margin: 0;
        font-size: 11px;             /* 🔴 reduced */
      }

      /* MAIN CONTENT */
      .content {
        position: relative;
        z-index: 5;
        margin-top: 88px;            /* 🔴 fixes empty page issue */
        font-size: 11px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }

      table td {
        padding: 1px 3px;            /* 🔴 compact rows */
        vertical-align: top;
        line-height: 1.2;
      }

      .r1-1 {
        width: 22%;
        font-weight: 500;
      }

      .r1-2 {
        width: 28%;
      }

      /* TAX / FEE TABLE */
      .tax-table-as {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
        font-size: 11px;
      }

      .tax-table-as th,
      .tax-table-as td {
        border: 1px solid #000;
        padding: 3px 4px;            /* 🔴 reduced */
        text-align: center;
      }

      .tax-table-as th {
        font-weight: 600;
      }

      .tax-table-as td:first-child {
        text-align: left;
      }

      .content__grand {
        margin-top: 10px;
        font-size: 11px;
      }

      .content__grand p {
        margin: 2px 0;
      }

      .main__warning {
        font-size: 11px;             /* 🔴 reduced */
        line-height: 15px;
        margin-top: 8px;
      }

      @media print {
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        a[href]:after {
          content: "";
        }
      }
    </style>
  </head>

  <body>
    <div class="main">
      <img class="qr-image-as" src="<%= data.src %>" />

      <div class="logo_as_main">
        <img src="/images1/Assam.png" />
      </div>

      <div class="logo_as">
        <img src="/images1/Assam.png" />
      </div>

      <div class="as-header">
        <h3>GOVERNMENT OF ASSAM</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <div class="content__back">
        <% for (let i = 0; i < 16; i++) { %>
        <p>
          <%=data.vehicleNo%> / <%=data.paymentDate%>,
          <%=data.vehicleNo%> / <%=data.paymentDate%>,
          <%=data.vehicleNo%> / <%=data.paymentDate%>
        </p>
        <% } %>
      </div>

      <!-- MAIN CONTENT -->
      <div class="content">
        <table>
          <tr class="r1 r11">
            <td class="r1-1">Registration No.</td>
            <td class="r1-2">: <b><%=data.vehicleNo%></b></td>
            <td class="r1-1">Receipt No.</td>
            <td class="r1-2">: <%=data.receiptNo%></td>
          </tr>
          <tr class="r1 r12">
            <td class="r1-1">Payment Date</td>
            <td class="r1-2">: <%=data.paymentDate%></td>
            <td class="r1-1">Owner Name</td>
            <td class="r1-2">: <%=data.ownerName%></td>
          </tr>
          <tr class="r1 r13">
            <td class="r1-1">Chassis No.</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
            <td>Tax Mode</td>
            <td>&nbsp;&nbsp;: <%=data.taxMode%></td>
          </tr>
          <tr class="r1 r16">
            <td class="r1-1">Vehicle Type</td>
            <td class="r1-2">
              &nbsp;&nbsp;:
              <div class="r16-3"><%=data.vehiclePermitType%></div>
            </td>
            <td>Vehicle Class</td>
            <td>&nbsp;&nbsp;: <%=data.vehicleClass%></td>
          </tr>
          <tr class="r1 r17">
            <td class="r1-1">Vehicle Category</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.vehicleCategory || '' %></td>
            <td>Mobile No.</td>
            <td>&nbsp;&nbsp;: <%=data.mobileNo%></td>
          </tr>
          <tr class="r1 r18">
            <td class="r1-1">Checkpost Name</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.borderBarrier%></td>
            <% if(data.vehiclePermitType === 'GOODS VEHICLE'){ %>
              <td>Gross Weight</td>
              <td>&nbsp;&nbsp;: <%=data.grossVehicleWeight%> KG.</td>
            <% } else { %>
              <td>
                Seating Cap(Ex. <br />
                Driver
              </td>
              <td>&nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%></td>
            <% } %>
          </tr>
          <tr class="r1 r19">
            <td class="r1-1">Sleeper Cap.</td>
            <td class="r1-2">
              &nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%>
            </td>
            <td>Bank Ref. No.</td>
            <td>&nbsp;&nbsp;: NA</td>
          </tr>
          <tr class="r1 r20">
            <td class="r1-1">Payment Mode</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.paymentMode%></td>
            <td>Service Type</td>
            <td class="r1-2">&nbsp;&nbsp;: NOT APPLICABLE</td>
          </tr>
          <tr class="r1 r21">
            <td class="r1-1">Permit Type</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.permitType%></td>
            <td>Permit Category</td>
            <td>&nbsp;&nbsp;:</td>
          </tr>
        </table>

        <!-- TAX / FEE PARTICULAR TABLE -->
        <table class="tax-table-as">
          <thead>
            <tr>
              <th>Tax/Fee Particular</th>
              <th>Tax/Fees</th>
              <th>Fine</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Passenger Tax ( <%=data.taxFrom%> to <%=data.taxTo%> )</td>
              <td><%=data.totalAmount%></td>
              <td>0</td>
              <td><%=data.totalAmount%></td>
            </tr>
          </tbody>
        </table>

        <!-- GRAND TOTAL + NOTE / TERMS -->
        <div class="content__grand content__grand--hr">
          <p>
            <span><b>Grand Total :</b></span>
            <b> <%=data.totalAmount%>/- ( <%=data.totalAmountInWord%> )</b>
          </p>
          <p>
            <b>Note :</b>
          </p>
          <p>
            <b>Terms and Conditions:</b>
          </p>
          <p>1. This is a computer generated printout and no signature is required.</p>
          <p>2. Should not carry unlawful/unaccompanied goods.</p>
          <p>
            3. If any false information/discrepancies are found at later, necessary action will be taken<br />
            against the vehicle owner/driver.
          </p>
        </div>

        <br />
        <p class="main__warning" style="font-size: 14px; line-height: 20px;">
          Scan the QR code for genuinity of the receipt, It should land at
          <span style="color: blue;"><u>https://kms.parivahan.gov.in</u></span> site. In case the URL is
          different, then receipt could be a fake one, please raise a complain.
        </p>
      </div>
    </div>
  </body>
</html>
