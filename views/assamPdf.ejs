<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      @page {
        size: A4;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
        font-size: 11px;
        line-height: 1.2;
        color: #000;
        background: #fff;
      }

      /* Full A4 canvas */
      .main {
        position: relative;
        width: 100%;
        height: 100vh; /* renderer will treat as one page height */
        padding: 18px 30px 30px 30px;
      }

      /* QR (fixed at top-right) */
      .qr-image-as {
        position: absolute;
        top: 18px;
        right: 30px;
        width: 120px;
        height: 120px;
        z-index: 20;
      }

      /* Logo top-left */
      .logo_as {
        position: absolute;
        top: 18px;
        left: 30px;
        z-index: 20;
      }
      .logo_as img {
        width: 95px;
        display: block;
      }

      /* Header centered */
      .as-header {
        position: absolute;
        top: 44px;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 20;
      }
      .as-header h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
      }
      .as-header p {
        margin: 0;
        font-size: 11px;
      }

      /*
        Receipt-wrap grows only until the end of content.
        Background + watermark are inside, so they stop with content area.
      */
      .receipt-wrap {
        position: relative;
        z-index: 5;
        margin-top: 120px;
        padding-bottom: 6px;
      }

      /*
        ✅ BG vehicle/date repeated lines (bounded height)
        This ensures it doesn't fill blank page below.
      */
      .content__back {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;

        /* ✅ IMPORTANT: stops at end of receipt content area */
        height: 355px; /* tune 330–390 depending on final content */

        opacity: 0.14;
        font-size: 10px;
        line-height: 1.35;
        white-space: nowrap;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
      }

      .content__back p {
        margin: 0;
      }

      /*
        ✅ Watermark: smaller + darker + centered in receipt content
      */
      .wm-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.16; /* darker */
        z-index: 2;
        pointer-events: none;
      }
      .wm-center img {
        width: 190px; /* smaller */
        display: block;
      }

      /* Foreground content */
      .content {
        position: relative;
        z-index: 5;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }

      table td {
        padding: 2px 4px;
        vertical-align: middle;
        line-height: 1.2;
      }

      .r1-1 {
        width: 22%;
        font-weight: 500;
        white-space: nowrap;
      }

      .r1-2 {
        width: 28%;
        padding-left: 6px;
        font-weight: 700;
      }

      .tax-table-as {
        width: 100%;
        margin-top: 10px;
        border-collapse: collapse;
      }

      .tax-table-as th,
      .tax-table-as td {
        border: 1px solid #000;
        padding: 4px 6px;
        text-align: center;
      }
      .tax-table-as td:first-child {
        text-align: left;
        font-weight: 500;
      }

      .content__grand {
        margin-top: 6px;
      }
      .content__grand p {
        margin: 2px 0;
      }

      /* ✅ Main warning formatted */
      .main__warning {
        margin-top: 12px;
        font-size: 13px;
        line-height: 1.5;
        font-weight: 800;
      }
      .main__warning a,
      .main__warning u {
        color: #0b57d0;
        text-decoration: underline;
        font-weight: 900;
      }
    </style>
  </head>

  <body>
    <%
      const hasValue = (v) =>
        v !== undefined && v !== null && String(v).trim() !== "";

      // Goods depends on vehicleClass for Assam
      const isGoodsClass = (data.vehicleClass || "") === "GOODS CARRIER";

      const payDate = data.paymentDate || data.receiptDate || "";

      // Sleeper cap should NOT force 0
      const sleeperCapValue = hasValue(data.sleeperCapacityExcludingDriver)
        ? data.sleeperCapacityExcludingDriver
        : hasValue(data.sleeperCap)
          ? data.sleeperCap
          : "";

      // Unladen weight for Goods
      const unladenWt = hasValue(data.unladenWeight) ? data.unladenWeight : "";
    %>

    <div class="main">
      <% if (data.src) { %>
        <img class="qr-image-as" src="<%= data.src %>" />
      <% } %>

      <div class="logo_as">
        <img src="/images1/Assam.png" alt="Assam Logo" />
      </div>

      <div class="as-header">
        <h3>GOVERNMENT OF ASSAM</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <div class="receipt-wrap">
        <!-- ✅ Background lines bounded height -->
        <div class="content__back">
          <% for (let i = 0; i < 26; i++) { %>
            <p>
              <%= data.vehicleNo || '' %><%= payDate ? (' ' + payDate) : '' %>
              &nbsp;&nbsp;&nbsp;&nbsp;
              <%= data.vehicleNo || '' %><%= payDate ? (' ' + payDate) : '' %>
              &nbsp;&nbsp;&nbsp;&nbsp;
              <%= data.vehicleNo || '' %><%= payDate ? (' ' + payDate) : '' %>
              &nbsp;&nbsp;&nbsp;&nbsp;
              <%= data.vehicleNo || '' %><%= payDate ? (' ' + payDate) : '' %>
            </p>
          <% } %>
        </div>

        <!-- ✅ Watermark -->
        <div class="wm-center">
          <img src="/images1/Assam.png" alt="Watermark" />
        </div>

        <div class="content">
          <table>
            <tr>
              <td class="r1-1">Registration No.</td>
              <td class="r1-2">: <%= data.vehicleNo || '' %></td>
              <td class="r1-1">Receipt No.</td>
              <td class="r1-2">: <%= data.receiptNo || '' %></td>
            </tr>

            <tr>
              <td class="r1-1">Payment Date</td>
              <td class="r1-2">: <%= payDate %></td>
              <td class="r1-1">Owner Name</td>
              <td class="r1-2">: <%= data.ownerName || '' %></td>
            </tr>

            <tr>
              <td class="r1-1">Chassis No.</td>
              <td class="r1-2">: <%= data.chassisNo || '' %></td>
              <td class="r1-1">Tax Mode</td>
              <td class="r1-2">: <%= data.taxMode || '' %></td>
            </tr>

            <tr>
              <td class="r1-1">Vehicle Type</td>
              <td class="r1-2">: <%= data.vehiclePermitType || '' %></td>
              <td class="r1-1">Vehicle Class</td>
              <td class="r1-2">: <%= data.vehicleClass || '' %></td>
            </tr>

            <tr>
              <td class="r1-1">Vehicle Category</td>
              <td class="r1-2">: <%= data.vehicleCategory || data.vehicleType || '' %></td>
              <td class="r1-1">Mobile No.</td>
              <td class="r1-2">: <%= data.mobileNo || '' %></td>
            </tr>

            <tr>
              <td class="r1-1">District</td>
              <td class="r1-2">
                : <%= data.borderBarrier || data.districtName || data.district || '' %>
              </td>

              <% if (isGoodsClass) { %>
                <td class="r1-1">Gross Weight</td>
                <td class="r1-2">: <%= data.grossVehicleWeight || '' %> KG</td>
              <% } else { %>
                <td class="r1-1">Seating Cap (Ex. Driver)</td>
                <td class="r1-2">
                  : <%= data.seatingCapacityExcludingDriver || data.seatingCapacity || '' %>
                </td>
              <% } %>
            </tr>

            <tr>
              <% if (isGoodsClass) { %>
                <td class="r1-1">Unladen Wt.</td>
                <td class="r1-2">: <%= unladenWt %></td>
              <% } else { %>
                <td class="r1-1">Sleeper Cap.</td>
                <td class="r1-2">: <%= sleeperCapValue %></td>
              <% } %>

              <td class="r1-1">Bank Ref. No.</td>
              <td class="r1-2">: <%= data.upBankRefNo || data.bankRefNo || 'NA' %></td>
            </tr>

            <tr>
              <td class="r1-1">Payment Mode</td>
              <td class="r1-2">: <%= data.paymentMode || '' %></td>
              <td class="r1-1">Service Type</td>
              <td class="r1-2">: <%= data.serviceType || 'NOT APPLICABLE' %></td>
            </tr>

            <tr>
              <td class="r1-1">Permit Type</td>
              <td class="r1-2">: <%= data.permitType || '' %></td>
              <td class="r1-1"></td>
              <td class="r1-2"></td>
            </tr>
          </table>

          <table class="tax-table-as">
            <thead>
              <tr>
                <th>Tax/Fee Particular</th>
                <th>Tax/Fees</th>
                <th>Fine</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  Passenger Tax (
                  <%= data.taxFrom || data.mvTaxFrom || '' %> to
                  <%= data.taxTo || data.mvTaxTo || '' %>
                  )
                </td>
                <td><%= data.totalAmount || 0 %></td>
                <td>0</td>
                <td><%= data.totalAmount || 0 %></td>
              </tr>
            </tbody>
          </table>

          <div class="content__grand">
            <p>
              <b>Grand Total :</b>
              <%= data.totalAmount || 0 %>/- (
              <%= data.totalAmountInWord || '' %> )
            </p>

            <p><b>Terms and Conditions:</b></p>
            <p>1. This is a computer generated printout and no signature is required.</p>
            <p>2. Should not carry unlawful/unaccompanied goods.</p>
            <p>
              3. If any false information/discrepancies are found at later,
              necessary action will be taken against the vehicle owner/driver.
            </p>
          </div>

          <p class="main__warning">
            Scan the QR code for genuinity of the receipt, It should land at
            <a href="https://kms.parivahan.gov.in">https://kms.parivahan.gov.in</a>
            site. In case the URL is different, then receipt could be a fake one,
            please raise a complain.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
