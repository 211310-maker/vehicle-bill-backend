<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <% if(data.cssFix){ %>
      <link rel="stylesheet" href="/css/cssFix.css" />
    <% } %>

    <style>
      /* PAGE & PRINT SETUP */
      @page {
        size: A4;
        margin: 0; /* remove default browser header/footer area */
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
      }

      .main {
        position: relative;
        width: 100%;
        max-width: 100%;
        padding: 20px 30px 40px 30px;
        box-sizing: border-box;
      }

      /* QR TOP-RIGHT */
      .qr-image-as {
        position: absolute;
        top: 20px;
        right: 35px;
        width: 135px;
        height: 135px;
        object-fit: contain;
        z-index: 10;
      }

      /* SMALL LOGO TOP-LEFT */
      .logo_as {
        position: absolute;
        top: 20px;
        left: 35px;
        z-index: 10;
      }

      .logo_as img {
        width: 110px;
        height: auto;
        display: block;
      }

      /* BIG WATERMARK (CENTER) */
      .logo_as_main {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.13;
        z-index: 1;
        pointer-events: none;
      }

      .logo_as_main img {
        width: 340px;
        height: auto;
      }

      /* BACKGROUND REPEATED TEXT */
      .content__back {
        position: absolute;
        top: 0;
        left: 40px;
        right: 40px;
        bottom: 0;
        z-index: 2;
        opacity: 0.08;
        pointer-events: none;
        font-size: 11px;
        line-height: 1.4;
        white-space: nowrap;
      }

      .content__back p {
        margin: 0;
      }

      /* HEADER: CENTERED 3-LINE TITLE */
      .as-header {
        position: absolute;
        top: 35px;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 5;
      }

      .as-header h3 {
        margin: 0 0 2px 0;
        font-size: 16px;
        font-weight: 700;
      }

      .as-header p {
        margin: 0;
        font-size: 13px;
      }

      /* RECEIPT DATE (TOP-LEFT UNDER LOGO) */
      .receipt-date-as {
        position: absolute;
        top: 140px;
        left: 35px;
        font-size: 11px;
        z-index: 5;
      }

      /* MAIN CONTENT BELOW HEADER */
      .content {
        position: relative;
        z-index: 5;
        margin-top: 115px; /* space for logo + QR + title */
        font-size: 12px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
      }

      table td {
        padding: 2px 4px;
        vertical-align: top;
      }

      .r1-1 {
        width: 22%;
        font-weight: 500;
      }

      .r1-2 {
        width: 28%;
      }

      /* MONEY TABLE */
      .content__money {
        margin-top: 14px;
        font-size: 12px;
      }

      .content__money-r1,
      .content__money-r2 {
        display: flex;
        border-bottom: 1px solid #000;
        padding: 4px 0;
      }

      .content__money-r1 .m1,
      .content__money-r2 .m1 {
        width: 55%;
      }

      .content__money-r1 .m2,
      .content__money-r1 .m3,
      .content__money-r1 .m4,
      .content__money-r2 .m2,
      .content__money-r2 .m3,
      .content__money-r2 .m4 {
        width: 15%;
        text-align: center;
      }

      .content__grand {
        margin-top: 18px;
        font-size: 12px;
      }

      .content__grand p {
        margin: 2px 0;
      }

      /* PRINT: DON'T APPEND URL AFTER LINKS */
      @media print {
        a[href]:after {
          content: "" !important;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>

  <body>
    <div class="main">
      <!-- QR top-right -->
      <img class="qr-image-as" src="<%= data.src %>" alt="" />

      <!-- BIG CENTER WATERMARK -->
      <div class="logo_as_main">
        <img src="/images1/Assam.png" alt="" />
      </div>

      <!-- SMALL TOP-LEFT LOGO -->
      <div class="logo_as">
        <img src="/images1/Assam.png" alt="" />
      </div>

      <!-- RECEIPT PRINTING DATE -->
      <div class="receipt-date-as">
        Receipt Printing Date:<br />
        <%=data.receiptDate%>
      </div>

      <!-- 3-LINE CENTERED HEADER -->
      <div class="as-header">
        <h3>GOVERNMENT OF ASSAM</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <!-- BACKGROUND REPEATED TEXT -->
      <div class="content__back">
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
        <p>
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
          <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
        </p>
      </div>

      <!-- MAIN CONTENT -->
      <div class="content">
        <table>
          <tr class="r1 r11">
            <td class="r1-1">Registration No.</td>
            <td class="r1-2">: <b><%=data.vehicleNo%></b></td>
            <td class="r1-1">Receipt No.</td>
            <td class="r1-2">: <%=data.receiptNo%></td>
          </tr>
          <tr class="r1 r12">
            <td class="r1-1">Payment Date</td>
            <td class="r1-2">: <%=data.paymentDate%></td>
            <td class="r1-1">Owner Name</td>
            <td class="r1-2">: <%=data.ownerName%></td>
          </tr>
          <tr class="r1 r13">
            <td class="r1-1">Chassis No.</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
            <td>Tax Mode</td>
            <td>&nbsp;&nbsp;: <%=data.taxMode%></td>
          </tr>
          <tr class="r1 r16">
            <td class="r1-1">Vehicle Type</td>
            <td class="r1-2">
              &nbsp;&nbsp;:
              <div class="r16-3"><%=data.vehiclePermitType%></div>
            </td>
            <td>Vehicle Class</td>
            <td>&nbsp;&nbsp;: <%=data.vehicleClass%></td>
          </tr>
          <tr class="r1 r17">
            <td class="r1-1">Vehicle Category</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.vehicleCategory || '' %></td>
            <td>Mobile No.</td>
            <td>&nbsp;&nbsp;: <%=data.mobileNo%></td>
          </tr>
          <tr class="r1 r18">
            <td class="r1-1">Checkpost Name</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.borderBarrier%></td>
            <% if(data.vehiclePermitType === 'GOODS VEHICLE'){ %>
              <td>Gross Weight</td>
              <td>&nbsp;&nbsp;: <%=data.grossVehicleWeight%> KG.</td>
            <% } else { %>
              <td>
                Seating Cap(Ex. <br />
                Driver
              </td>
              <td>&nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%></td>
            <% } %>
          </tr>
          <tr class="r1 r19">
            <td class="r1-1">Sleeper Cap.</td>
            <td class="r1-2">
              &nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%>
            </td>
            <td>Bank Ref. No.</td>
            <td>&nbsp;&nbsp;: NA</td>
          </tr>
          <tr class="r1 r20">
            <td class="r1-1">Payment Mode</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.paymentMode%></td>
            <td>Service Type</td>
            <td class="r1-2">&nbsp;&nbsp;: NOT APPLICABLE</td>
          </tr>
          <tr class="r1 r21">
            <td class="r1-1">Permit Type</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.permitType%></td>
            <td>Permit Category</td>
            <td>&nbsp;&nbsp;:</td>
          </tr>
        </table>

        <div class="content__money">
          <div class="content__money-r1 d-flex">
            <div class="m1"><b>Particular</b></div>
            <div class="m2"><b>Fees/Tax</b></div>
            <div class="m3"><b>Fine</b></div>
            <div class="m4"><b>Total</b></div>
          </div>
          <div class="content__money-r2 d-flex">
            <div class="m1">Passenger Tax ( <%=data.taxFrom%> to <%=data.taxTo%> )</div>
            <div class="m2"><%=data.totalAmount%></div>
            <div class="m3">0</div>
            <div class="m4"><%=data.totalAmount%></div>
          </div>
        </div>

        <div class="content__grand content__grand--hr">
          <p>
            <span><b>Grand Total :</b></span>
            ₹ <%=data.totalAmount%>/- ( <%=data.totalAmountInWord%> )
          </p>
          <p>
            <i>
              Note : 1) This is a computer generated printout and no signature is required
            </i>
          </p>
          <p>
            <i>
              2) Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and
              defaulter shall be a liable for penal action. <br /><br />
              you will also receive the payment confirmation message.
            </i>
          </p>
          <br />
          <br />
          <p class="main__warning" style="font-size: 14px; line-height: 20px;">
            Scan the QR code for genuinity of the receipt, It should land at
            <span style="color: blue;"><u>https://kms.privahan.gov.in</u></span> site. In case the URL is
            different, then receipt could be a fake one, please raise a complain.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
