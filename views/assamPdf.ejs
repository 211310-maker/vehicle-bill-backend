<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    @page { size: A4; margin: 0; }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Roboto", sans-serif;
      font-size: 11px;
      color: #000;
      background: #fff;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }

    /* PAGE */
    .page {
      position: relative;
      width: 210mm;
      height: 297mm;
      margin: 0 auto;
      padding: 18mm 16mm;
      overflow: hidden;
    }

    /* HEADER */
    .logo {
      position: absolute;
      top: 10mm;
      left: 35mm;
      width: 90px;
    }

    .qr {
      position: absolute;
      top: 10mm;
      right: 27mm;
      width: 120px;
    }

    .header {
      text-align: center;
      margin-top: 3mm;
      line-height: 1.3;
    }

    .header h1 {
      margin: 0;
      font-size: 13px;
      font-weight: 700;
      text-decoration: underline;
    }

    .header p {
      margin: 0;
      font-size: 11px;
      font-weight: 700;
    }

    /* BACKGROUND TEXT */
    .bg-text {
      position: absolute;
      inset: 0;
      max-width: 90mm;
      padding: 10mm 25mm 90mm 10mm;
      opacity: 0.25;
      font-size: 14px;
      line-height: 1.15;
      color: #7f7f7f;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .bg-text div {
      white-space: nowrap;
      transform: scaleX(0.9);
    }

    /* WATERMARK */
    .watermark {
      position: absolute;
      top: 27%;
      left: 55%;
      transform: translate(-50%, -50%);
      opacity: 0.30;
      z-index: 1;
      pointer-events: none;
    }

    .watermark img { width: 200px; }

    /* CONTENT */
    .content {
      position: relative;
      z-index: 2;
      margin-top: 15mm;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }

    td {
      padding: 4px 2px;
      vertical-align: top;
    }

    .label {
      width: 22%;
      font-weight: 500;
      white-space: nowrap;
    }

    .value {
      width: 28%;
      font-weight: 700;
    }

    /* TAX TABLE */
    .tax-table {
      margin-top: 12px;
      width: 100%;
      border-collapse: collapse;
    }

    .tax-table th,
    .tax-table td {
      border: 1px solid #6fa8ff;
      padding: 5px;
      text-align: center;
    }

    .tax-table td:first-child {
      text-align: left;
      font-weight: 500;
    }

    /* FOOTER */
    .grand {
      margin-top: 8px;
      font-weight: 700;
    }

    .terms {
      margin-top: 6px;
      font-size: 10.5px;
    }

    .warning {
      margin-top: 14px;
      font-size: 18px;
      font-weight: 900;
      line-height: 1.4;
    }

    .warning a {
      display: inline-block;      /* ensures clean line */
      color: #0b57d0;              /* govt blue */
      font-weight: 900;
      text-decoration: underline;
      margin: 2px 0;
    }
  </style>
</head>

<body>

<%
  const has = (v) => v !== undefined && v !== null && String(v).trim() !== "";
  const bgLine = `${data.vehicleNo || ''} ${data.paymentDate || data.receiptDate || ''}`.trim();

  const isGoods = (data.vehicleClass || '').includes('GOODS');
%>

<div class="page">

  <!-- BG TEXT -->
  <div class="bg-text">
    <% for (let i = 0; i < 28; i++) { %>
      <div><%= bgLine %>&nbsp;&nbsp;<%= bgLine %></div>
    <% } %>
  </div>

  <!-- WATERMARK -->
  <div class="watermark">
    <img src="/images1/Assam.png" />
  </div>

  <!-- HEADER -->
  <img class="logo" src="/images1/Assam.png" />
  <img class="qr" src="<%= data.src %>" />

  <div class="header">
    <h1>GOVERNMENT OF ASSAM</h1>
    <p>Department of Transport</p>
    <p>Checkpost Tax e-Receipt</p>
  </div>

  <!-- CONTENT -->
  <div class="content">
    <table>
      <tr>
        <td class="label">Registration No.</td><td class="value">: <%= data.vehicleNo || '' %></td>
        <td class="label">Receipt No.</td><td class="value">: <%= data.receiptNo || '' %></td>
      </tr>
      <tr>
        <td class="label">Payment Date</td><td class="value">: <%= data.paymentDate || data.receiptDate || '' %></td>
        <td class="label">Owner Name</td><td class="value">: <%= data.ownerName || '' %></td>
      </tr>
      <tr>
        <td class="label">Chassis No.</td><td class="value">: <%= data.chassisNo || '' %></td>
        <td class="label">Tax Mode</td><td class="value">: <%= data.taxMode || '' %></td>
      </tr>
      <tr>
        <td class="label">Vehicle Type</td><td class="value">: TRANSPORT</td>
        <td class="label">Vehicle Class</td><td class="value">: <%= data.vehicleClass || '' %></td>
      </tr>
      <tr>
        <td class="label">Vehicle Category</td><td class="value">: <%= data.vehicleCategory || '' %></td>
        <td class="label">Mobile No.</td><td class="value">: <%= data.mobileNo || '' %></td>
      </tr>
      <tr>
        <td class="label">District / Checkpost</td>
        <td class="value">: <%= data.borderBarrier || data.district || '' %></td>

        <% if (isGoods) { %>
          <td class="label">Gross Weight</td>
          <td class="value">: <%= data.grossVehicleWeight || '' %></td>
        <% } else { %>
          <td class="label">Seating Capacity</td>
          <td class="value">: <%= data.seatingCapacityExcludingDriver || data.seatingCapacity || '' %></td>
        <% } %>
      </tr>
      <tr>
        <% if (!isGoods) { %>
          <td class="label">Sleeper Cap</td>
          <td class="value">: <%= data.sleeperCapacityExcludingDriver || '' %></td>
        <% } else { %>
          <td class="label">Unladen Weight</td>
          <td class="value">: <%= data.unladenWeight || '' %></td>
        <% } %>

        <td class="label">Bank Ref. No.</td>
        <td class="value">: TXV456767823 %></td>
      </tr>
      <tr>
        <td class="label">Payment Mode</td>
        <td class="value">: <%= data.paymentMode || '' %></td>
        <td class="label">Service Type</td>
        <td class="value">: <%= data.serviceType || 'NOT APPLICABLE' %></td>
      </tr>
      <tr>
        <td class="label">Permit Type</td>
        <td class="value">: <%= data.permitType || 'NOT APPLICABLE' %></td>
        <td></td><td></td>
      </tr>
    </table>

    <table class="tax-table">
      <thead>
        <tr>
          <th>Tax/Fee Particular</th>
          <th>Tax/Fees</th>
          <th>Fine</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            Passenger Tax (<%= data.taxFrom || '' %> to <%= data.taxTo || '' %>)
          </td>
          <td><%= data.totalAmount || 0 %></td>
          <td>0</td>
          <td><%= data.totalAmount || 0 %></td>
        </tr>
      </tbody>
    </table>

    <div class="grand">
      Grand Total : <%= data.totalAmount || 0 %>/- (<%= data.totalAmountInWord || '' %>)
    </div>

    <div class="terms">
      <div class="hdr">Note :</div>
      <b>Terms and Conditions:</b><br>
      1. This is a computer generated printout and no signature is required.<br>
      2. Should not carry unlawful/unaccompanied goods.<br>
      3. If any discrepancies are found, action will be taken against the vehicle owner/driver.
    </div>

    <div class="warning">
      Scan the QR code for genuinity of the receipt, It should land at
      <a href="https://kms.parivahan.gov.in">https://kms.parivahan.gov.in</a>.
      In case the URL is different, then receipt could be fake, please raise a complain.
    </div>
  </div>
</div>

</body>
</html>
