<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      @page {
        size: A4;
        margin: 0;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
        font-size: 11px;
        line-height: 1.2;
        color: #000;
      }

      .main {
        position: relative;
        width: 100%;
        padding: 18px 30px 30px 30px;
        box-sizing: border-box;
      }

      /* QR */
      .qr-image-as {
        position: absolute;
        top: 18px;
        right: 30px;
        width: 120px;
        height: 120px;
        z-index: 10;
      }

      /* Logos */
      .logo_as {
        position: absolute;
        top: 18px;
        left: 30px;
        z-index: 10;
      }

      .logo_as img {
        width: 95px;
        display: block;
      }

      .logo_as_main {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.07;
        z-index: 1;
        pointer-events: none;
      }

      .logo_as_main img {
        width: 330px;
      }

      /* Header */
      .as-header {
        position: absolute;
        top: 44px;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 5;
      }

      .as-header h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
      }

      .as-header p {
        margin: 0;
        font-size: 11px;
      }

      /* Background watermark text */
      .content__back {
        position: absolute;
        top: 115px;
        left: 30px;
        right: 30px;
        bottom: 120px;
        opacity: 0.12;
        font-size: 10px;
        line-height: 1.3;
        white-space: nowrap;
        z-index: 2;
        pointer-events: none;
      }

      .content__back p {
        margin: 0;
      }

      /* Main content */
      .content {
        position: relative;
        z-index: 5;
        margin-top: 120px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }

      table td {
        padding: 2px 4px;
        vertical-align: middle;
        line-height: 1.2;
      }

      .r1-1 {
        width: 22%;
        font-weight: 500;
        white-space: nowrap;
      }

      .r1-2 {
        width: 28%;
        padding-left: 6px;
      }

      /* Tax table */
      .tax-table-as {
        width: 100%;
        margin-top: 8px;
        border-collapse: collapse;
      }

      .tax-table-as th,
      .tax-table-as td {
        border: 1px solid #000;
        padding: 3px 4px;
        text-align: center;
      }

      .tax-table-as td:first-child {
        text-align: left;
      }

      .content__grand p {
        margin: 2px 0;
      }

      .main__warning {
        font-size: 11px;
        line-height: 15px;
        margin-top: 8px;
      }
    </style>
  </head>

  <body>
    <div class="main">
      <img class="qr-image-as" src="<%= data.src %>" />

      <div class="logo_as_main">
        <img src="/images1/Assam.png" />
      </div>

      <div class="logo_as">
        <img src="/images1/Assam.png" />
      </div>

      <div class="as-header">
        <h3>GOVERNMENT OF ASSAM</h3>
        <p>Department of Transport</p>
        <p>Checkpost Tax e-Receipt</p>
      </div>

      <div class="content__back">
        <% for (let i = 0; i < 16; i++) { %>
          <p>
            <%= data.vehicleNo %> / <%= data.paymentDate %>,
            <%= data.vehicleNo %> / <%= data.paymentDate %>
          </p>
        <% } %>
      </div>

      <div class="content">
        <table>
          <tr>
            <td class="r1-1">Registration No.</td>
            <td class="r1-2">: <b><%= data.vehicleNo %></b></td>
            <td class="r1-1">Receipt No.</td>
            <td class="r1-2">: <%= data.receiptNo %></td>
          </tr>

          <tr>
            <td class="r1-1">Payment Date</td>
            <td class="r1-2">: <%= data.paymentDate %></td>
            <td class="r1-1">Owner Name</td>
            <td class="r1-2">: <%= data.ownerName %></td>
          </tr>

          <tr>
            <td class="r1-1">Chassis No.</td>
            <td class="r1-2">: <%= data.chassisNo %></td>
            <td class="r1-1">Tax Mode</td>
            <td class="r1-2">: <%= data.taxMode %></td>
          </tr>

          <tr>
            <td class="r1-1">Vehicle Type</td>
            <td class="r1-2">: <%= data.vehiclePermitType %></td>
            <td class="r1-1">Vehicle Class</td>
            <td class="r1-2">: <%= data.vehicleClass %></td>
          </tr>

          <tr>
            <td class="r1-1">Vehicle Category</td>
            <td class="r1-2">: <%= data.vehicleCategory || "NA" %></td>
            <td class="r1-1">Mobile No.</td>
            <td class="r1-2">: <%= data.mobileNo %></td>
          </tr>

          <tr>
            <td class="r1-1">District</td>
            <td class="r1-2">: <%= data.borderBarrier %></td>

            <% if (data.vehiclePermitType === 'GOODS VEHICLE') { %>
              <td class="r1-1">Gross Weight</td>
              <td class="r1-2">: <%= data.grossVehicleWeight %> KG</td>
            <% } else { %>
              <td class="r1-1">Seating Cap (Ex. Driver)</td>
              <td class="r1-2">: <%= data.seatingCapacityExcludingDriver %></td>
            <% } %>
          </tr>

          <tr>
            <td class="r1-1">Sleeper Cap.</td>
            <td class="r1-2">: <%= data.sleeperCapacityExcludingDriver %></td>
            <td class="r1-1">Bank Ref. No.</td>
            <td class="r1-2">: NA</td>
          </tr>

          <tr>
            <td class="r1-1">Payment Mode</td>
            <td class="r1-2">: <%= data.paymentMode %></td>
            <td class="r1-1">Service Type</td>
            <td class="r1-2">: NOT APPLICABLE</td>
          </tr>

          <tr>
            <td class="r1-1">Permit Type</td>
            <td class="r1-2">: <%= data.permitType %></td>
            <td class="r1-1">Permit Category</td>
            <td class="r1-2">:</td>
          </tr>
        </table>

        <table class="tax-table-as">
          <thead>
            <tr>
              <th>Tax/Fee Particular</th>
              <th>Tax/Fees</th>
              <th>Fine</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                Passenger Tax (
                <%= data.taxFrom %> to <%= data.taxTo %>
                )
              </td>
              <td><%= data.totalAmount %></td>
              <td>0</td>
              <td><%= data.totalAmount %></td>
            </tr>
          </tbody>
        </table>

        <div class="content__grand">
          <p>
            <b>Grand Total :</b>
            <%= data.totalAmount %>/- (
            <%= data.totalAmountInWord %> )
          </p>

          <p><b>Terms and Conditions:</b></p>
          <p>1. This is a computer generated printout and no signature is required.</p>
          <p>2. Should not carry unlawful/unaccompanied goods.</p>
          <p>
            3. If any false information/discrepancies are found at later,
            necessary action will be taken against the vehicle owner/driver.
          </p>
        </div>

        <p class="main__warning">
          Scan the QR code for genuinity of the receipt. It should land at
          <u>https://kms.parivahan.gov.in</u>. If the URL differs, the receipt
          could be fake.
        </p>
      </div>
    </div>
  </body>
</html>
