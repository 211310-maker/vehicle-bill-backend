<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
    rel="stylesheet"
  />

  <style>
    @page {
      size: A4;
      margin: 10mm;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Roboto", sans-serif;
      font-size: 11px;
      line-height: 1.2;
      color: #000;
    }

    .main {
      position: relative;
      width: 100%;
      min-height: 277mm;
      padding: 18px 25px;
      box-sizing: border-box;
    }

    /* QR */
    .qr-image-as {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 120px;
      height: 120px;
      z-index: 10;
    }

    /* LOGO */
    .logo_as {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 10;
    }

    .logo_as img {
      width: 95px;
    }

    /* WATERMARK */
    .logo_as_main {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.07;
      z-index: 1;
      pointer-events: none;
    }

    .logo_as_main img {
      width: 330px;
    }

    /* HEADER */
    .as-header {
      position: absolute;
      top: 24px;
      left: 0;
      right: 0;
      text-align: center;
      z-index: 5;
    }

    .as-header h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 700;
    }

    .as-header p {
      margin: 0;
      font-size: 11px;
    }

    /* BACKGROUND TEXT */
    .content__back {
      position: absolute;
      top: 85px;
      left: 25px;
      right: 25px;
      bottom: 120px;
      font-size: 10px;
      line-height: 1.3;
      opacity: 0.12;
      white-space: nowrap;
      z-index: 2;
      pointer-events: none;
    }

    .content__back p {
      margin: 0;
    }

    /* CONTENT */
    .content {
      position: relative;
      z-index: 5;
      margin-top: 85px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }

    td {
      padding: 1px 3px;
      vertical-align: top;
    }

    .r1-1 {
      width: 22%;
      font-weight: 500;
    }

    .r1-2 {
      width: 28%;
    }

    /* TAX TABLE */
    .tax-table-as {
      margin-top: 8px;
    }

    .tax-table-as th,
    .tax-table-as td {
      border: 1px solid #000;
      padding: 3px 4px;
      text-align: center;
    }

    .tax-table-as td:first-child {
      text-align: left;
    }

    .content__grand p {
      margin: 2px 0;
    }

    .main__warning {
      font-size: 11px;
      line-height: 15px;
      margin-top: 10px;
    }
  </style>
</head>

<body>
<div class="main">

  <!-- QR -->
  <img class="qr-image-as" src="<%= data.src %>" />

  <!-- LOGOS -->
  <div class="logo_as">
    <img src="/images1/Assam.png" />
  </div>

  <div class="logo_as_main">
    <img src="/images1/Assam.png" />
  </div>

  <!-- HEADER -->
  <div class="as-header">
    <h3>GOVERNMENT OF ASSAM</h3>
    <p>Department of Transport</p>
    <p>Checkpost Tax e-Receipt</p>
  </div>

  <!-- BACKGROUND -->
  <div class="content__back">
    <% for (let i = 0; i < 16; i++) { %>
      <p><%= data.vehicleNo %> / <%= data.paymentDate %></p>
    <% } %>
  </div>

  <!-- MAIN CONTENT -->
  <div class="content">
    <table>
      <tr>
        <td class="r1-1">Registration No.</td>
        <td class="r1-2">: <b><%= data.vehicleNo %></b></td>
        <td class="r1-1">Receipt No.</td>
        <td class="r1-2">: <%= data.receiptNo %></td>
      </tr>

      <tr>
        <td class="r1-1">Payment Date</td>
        <td class="r1-2">: <%= data.paymentDate %></td>
        <td class="r1-1">Owner Name</td>
        <td class="r1-2">: <%= data.ownerName %></td>
      </tr>

      <tr>
        <td class="r1-1">Chassis No.</td>
        <td class="r1-2">: <%= data.chassisNo %></td>
        <td class="r1-1">Mobile No.</td>
        <td class="r1-2">: <%= data.mobileNo %></td>
      </tr>

      <tr>
        <td class="r1-1">Vehicle Type</td>
        <td class="r1-2">: <%= data.vehiclePermitType %></td>
        <td class="r1-1">Vehicle Class</td>
        <td class="r1-2">: <%= data.vehicleClass %></td>
      </tr>

      <tr>
        <td class="r1-1">Permit Type</td>
        <td class="r1-2">: <%= data.permitType %></td>
        <td class="r1-1">Tax Mode</td>
        <td class="r1-2">: <%= data.taxMode %></td>
      </tr>

      <tr>
        <td class="r1-1">District</td>
        <td class="r1-2">: <%= data.borderBarrier %></td>
        <td class="r1-1">Checkpost Name</td>
        <td class="r1-2">: <%= data.checkpostName %></td>
      </tr>

      <% if (data.vehiclePermitType === 'GOODS VEHICLE') { %>
      <tr>
        <td class="r1-1">Gross Vehicle Weight</td>
        <td class="r1-2">: <%= data.grossVehicleWeight %> KG</td>
        <td class="r1-1">Payment Mode</td>
        <td class="r1-2">: <%= data.paymentMode %></td>
      </tr>
      <% } else { %>
      <tr>
        <td class="r1-1">Seating Capacity</td>
        <td class="r1-2">: <%= data.seatingCapacityExcludingDriver %></td>
        <td class="r1-1">Sleeper Capacity</td>
        <td class="r1-2">: <%= data.sleeperCapacityExcludingDriver %></td>
      </tr>

      <tr>
        <td class="r1-1">Service Type</td>
        <td class="r1-2">: <%= data.serviceType || 'NOT APPLICABLE' %></td>
        <td class="r1-1">Payment Mode</td>
        <td class="r1-2">: <%= data.paymentMode %></td>
      </tr>
      <% } %>
    </table>

    <!-- TAX TABLE -->
    <table class="tax-table-as">
      <thead>
        <tr>
          <th>Tax/Fee Particular</th>
          <th>Tax/Fees</th>
          <th>Fine</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            Passenger Tax (
            <%= data.taxFromDate %> to <%= data.taxUptoDate %>
            )
          </td>
          <td><%= data.totalAmount %></td>
          <td>0</td>
          <td><%= data.totalAmount %></td>
        </tr>
      </tbody>
    </table>

    <!-- FOOTER -->
    <div class="content__grand">
      <p><b>Grand Total :</b> <%= data.totalAmount %>/-</p>
      <p><b>Terms and Conditions:</b></p>
      <p>1. This is a computer generated receipt and no signature is required.</p>
      <p>2. Should not carry unlawful/unaccompanied goods.</p>
      <p>3. Any false information may invite legal action.</p>
    </div>

    <p class="main__warning">
      Scan the QR code for genuinity of the receipt. It should land at
      <u>https://kms.parivahan.gov.in</u>. If the URL differs, the receipt may be fake.
    </p>
  </div>
</div>
</body>
</html>
