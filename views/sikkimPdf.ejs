<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Tax - Sikkim Receipt</title>

    <style>
      @page { size: A4; margin: 14mm; }

      /* Use classic serif to match original receipt */
      body {
        margin: 0;
        padding: 0;
        font-family: "Times New Roman", Times, serif;
        color: #000;
        background: #fff;
      }

      .page {
        position: relative;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        background: #fff;
        overflow: hidden;
      }

      /* QR on top-right */
      .qr {
        position: absolute;
        top: 10px;
        right: 12px;
        width: 155px;
        height: 155px;
        object-fit: contain;
        z-index: 60; /* very top */
        background: #fff;
      }

      /* ===== MAIN CONTENT ===== */
      .content {
        position: relative;
        z-index: 30;               /* above emblem (20) and lines (10) */
        padding: 10px 14px 12px 14px;
      }

      /* ===== WATERMARK LINES (inside content, clipped to receipt) =====
         Key points:
         - absolutely positioned inside .content so it is clipped to receipt area
         - right offset reserves space for QR (adjust QR_WIDTH if you change QR)
         - text repeated tightly to appear continuous
      */
      .wm-text-layer {
        position: absolute;
        top: 0;
        left: 14px;               /* match .content left padding */
        right: 14px;              /* we will reserve QR with inner rule on each line */
        bottom: 0;
        z-index: 10;              /* behind content (30) and emblem (20 above lines) */
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: stretch;
        overflow: hidden;
        padding-top: 8px;
        padding-bottom: 8px;
      }

      /* Each repeated line — we use a single long inline-block to avoid wrapping gaps */
      .wm-line {
        display: block;
        width: 100%;
        margin: 8px 0;              /* vertical spacing between watermark lines */
        font-family: "Times New Roman", Times, serif;
        font-size: 13px;           /* tune to match original */
        line-height: 14px;
        color: rgba(0,0,0,0.14);   /* slightly stronger so it shows up in print */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: clip;
      }

      /* To make lines appear continuous up to the QR area:
         inside each line we wrap the long repeated string and then add a side mask on right
         by using a right padding on the text and letting QR overlay on top (QR has higher z-index).
      */
      .wm-line .wm-line-text {
        display: inline-block;
        padding-right: 200px; /* reserve extra space for QR so text doesn't flow under QR (adjust if you change QR size) */
        transform: translateZ(0); /* help rendering */
      }

      /* ===== EMBLEM (centered, above lines but behind content) ===== */
      .wm-emblem {
        position: absolute;
        left: 50%;
        top: 145px;
        transform: translateX(-50%);
        width: 255px;           /* slightly larger for better coverage */
        opacity: 0.28;
        z-index: 20;            /* above lines (10) but below content (30) */
        pointer-events: none;
      }

      /* ===== HEADER ===== */
      .header {
        text-align: center;
        line-height: 1.08;
        margin-top: 8px;
      }

      .header .h1 {
        font-weight: 700;
        font-size: 16px;
        margin: 0;
        text-transform: uppercase;
        display: inline-block;
        padding-bottom: 2px;
        border-bottom: 1px solid #000;
      }

      .header .h2 { font-weight: 700; font-size: 13px; margin: 4px 0 0 0; }
      .header .h3 { font-weight: 700; font-size: 13px; margin: 3px 0 0 0; }
      .header .h4 { font-weight: 700; font-size: 11px; margin: 3px 0 0 0; }

      /* ===== DETAILS ===== */
      .details-wrap { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 34px; font-size: 12px; }

      .drow { display: grid; grid-template-columns: 135px 12px 1fr; align-items: start; margin-bottom: 4px; }
      .drow .label { font-weight: 700; }
      .drow .colon { font-weight: 700; text-align: center; }
      .drow .value { font-weight: 700; word-break: break-word; }

      /* ===== MONEY TABLE ===== */
      .money { margin-top: 12px; border-top: 1px solid #000; border-bottom: 1px solid #000; font-size: 12px; }
      .money .head, .money .row { display: grid; grid-template-columns: 1fr 90px 70px 70px; }
      .money .head { font-weight: 700; border-bottom: 1px solid #000; }
      .money .cell { padding: 3px 6px; }
      .money .num { text-align: right; }

      /* ===== NOTES ===== */
      .grand { margin-top: 8px; font-size: 12px; }
      .note { margin-top: 2px; font-style: italic; font-size: 11px; }
      .mt6 { margin-top: 6px; }
    </style>
  </head>

  <body>
    <%
      const wmVehicle = (data.vehicleNo || "").toString();
      const wmDate = (data.paymentDate || data.receiptDate || "").toString();
      const wmText = `${wmVehicle} / ${wmDate}`;

      const from = data.taxFrom || data.taxFromDate || "";
      const to = data.taxTo || data.taxUptoDate || "";
      const amt = Number(data.totalAmount || data.permitFee || 0) || 0;

      const vType = (data.vehiclePermitType || "").toString().toUpperCase();
      const isGoods = vType === "GOODS VEHICLE";

      // create a long repeated string without NBSP to avoid dotted gaps
      const makeLong = (text, repeats = 40) => {
        // use a small visible separator (a dash) instead of multiple NBSPs to avoid dotted appearance
        return Array(repeats).fill(text).join("  —  ");
      };
    %>

    <div class="page">
      <!-- QR -->
      <img class="qr" src="<%= data.src %>" alt="QR" />

      <div class="content">
        <!-- Watermark repeated lines (clipped to content region) -->
        <div class="wm-text-layer" aria-hidden="true">
          <% for (let i = 0; i < 36; i++) { %>
            <div class="wm-line">
              <span class="wm-line-text"><%= makeLong(wmText, 36) %></span>
            </div>
          <% } %>
        </div>

        <!-- Emblem watermark -->
        <img class="wm-emblem" src="/images1/Sikkim.jpg" alt="Watermark" />

        <div class="header">
          <div class="h1">GOVERNMENT OF SIKKIM</div>
          <div class="h2">Department of Transport</div>
          <div class="h3">Checkpost e-Receipt</div>
          <div class="h4">In terms of Section 87(1) b &amp; c of CMV act 1988</div>
        </div>

        <div class="details-wrap">
          <!-- LEFT -->
          <div>
            <div class="drow"><div class="label">Registration No.</div><div class="colon">:</div><div class="value"><%= data.vehicleNo || "" %></div></div>
            <div class="drow"><div class="label">Receipt No.</div><div class="colon">:</div><div class="value"><%= data.receiptNo || "" %></div></div>
            <div class="drow"><div class="label">Payment Date</div><div class="colon">:</div><div class="value"><%= data.paymentDate || data.receiptDate || "" %></div></div>
            <div class="drow"><div class="label">Owner Name</div><div class="colon">:</div><div class="value"><%= data.ownerName || "" %></div></div>
            <div class="drow"><div class="label">Chassis No.</div><div class="colon">:</div><div class="value"><%= data.chassisNo || "" %></div></div>
            <div class="drow"><div class="label">Vehicle Type</div><div class="colon">:</div><div class="value"><%= data.vehiclePermitType || "" %></div></div>
            <div class="drow"><div class="label">Mobile No.</div><div class="colon">:</div><div class="value"><%= data.mobileNo || "" %></div></div>
            <div class="drow"><div class="label">Service Type</div><div class="colon">:</div><div class="value"><%= (data.serviceType || "NOT APPLICABLE") %></div></div>
            <div class="drow"><div class="label">Bank Ref. No.</div><div class="colon">:</div><div class="value"><%= (data.upBankRefNo || data.bankRefNo || "NA") %></div></div>

            <% if (!isGoods) { %>
              <div class="drow"><div class="label">Sleeper Cap.</div><div class="colon">:</div><div class="value"><%= (data.sleeperCap || data.sleeperCapacityExcludingDriver || "") %></div></div>
            <% } %>

            <div class="drow"><div class="label">Permit Type</div><div class="colon">:</div><div class="value"><%= data.permitType || "NOT APPLICABLE" %></div></div>
          </div>

          <!-- RIGHT -->
          <div>
            <div class="drow"><div class="label">Tax Mode</div><div class="colon">:</div><div class="value"><%= data.taxMode || "" %></div></div>
            <div class="drow"><div class="label">Vehicle Class</div><div class="colon">:</div><div class="value"><%= data.vehicleClass || "" %></div></div>
            <div class="drow"><div class="label">Checkpost Name</div><div class="colon">:</div><div class="value"><%= (data.borderBarrier || data.districtName || data.district || "") %></div></div>

            <% if (!isGoods) { %>
              <div class="drow"><div class="label">Seat Cap(Ex. Driver)</div><div class="colon">:</div><div class="value"><%= (data.seatingCapacityExcludingDriver || data.seatingCapacity || "") %></div></div>
            <% } else { %>
              <div class="drow"><div class="label">Gross Weight</div><div class="colon">:</div><div class="value"><%= (data.grossVehicleWeight || "") %></div></div>
              <div class="drow"><div class="label">Unladen Wt.</div><div class="colon">:</div><div class="value"><%= (data.unladenWeight || "") %></div></div>
            <% } %>

            <div class="drow"><div class="label">Payment Mode</div><div class="colon">:</div><div class="value"><%= (data.paymentMode || "") %></div></div>
          </div>
        </div>

        <div class="money">
          <div class="head">
            <div class="cell">Particular</div>
            <div class="cell num">Fees/Tax</div>
            <div class="cell num">Fine</div>
            <div class="cell num">Total</div>
          </div>

          <div class="row">
            <div class="cell">Permit Fee(<%= from %> To <%= to %>)</div>
            <div class="cell num"><%= amt %></div>
            <div class="cell num">0</div>
            <div class="cell num"><%= amt %></div>
          </div>
        </div>

        <div class="grand">
          <div><b>Grand Total :</b> ₹ <%= amt %>/- ( <%= data.totalAmountInWord || "" %> )</div>
          <div class="note">Note : 1) This is a computer generated printout and no signature is required.</div>
          <div class="note">2) Incorrect mentioning of vehicle class or seating capacity may lead to tax evasion and defaulter shall be liable for penal action.</div>
          <div class="note mt6">You will also receive the payment confirmation message.</div>
        </div>
      </div>
    </div>
  </body>
</html>
