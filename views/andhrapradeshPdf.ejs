<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="<%= data.host %>/css/style.css" />
    <% if (data.cssFix) { %>
      <link rel="stylesheet" href="<%= data.host %>/css/cssFix.css" />
    <% } %>

   <style>
  * { box-sizing: border-box; }

  @page { size: A4; margin: 0; }

  html, body{
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #fff !important;
    transform: none !important;
    zoom: 1 !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-family: "Roboto", Arial, Helvetica, sans-serif !important;
    font-size: 13.5px !important;     /* big like Daman */
    font-weight: 500 !important;
    color: #000 !important;
  }

  /* If you have a wrapper .page, this centers in browser */
  .page{
    width: 100vw !important;
    min-height: 100vh !important;
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    background: #fff !important;
  }

  /* A4 canvas (MUST be fixed mm, not %) */
  .main{
    width: 210mm !important;
    min-height: 297mm !important;
    margin: 0 auto !important;
    padding: 12mm 15mm !important;
    position: relative !important;
    overflow: hidden !important;
    transform: none !important;
    zoom: 1 !important;
  }

  /* ---------- BACKGROUND VEHICLE/DATE (inside content area) ---------- */
  .content__back{
    position: absolute !important;
    top: 12mm !important;
    left: 15mm !important;
    right: 15mm !important;
    bottom: 12mm !important;
    z-index: 0 !important;
    opacity: 0.10 !important;
    pointer-events: none !important;
    font-size: 13px !important;
    line-height: 1.45 !important;
  }
  .content__back p{
    margin: 0 !important;
    display: flex !important;
    justify-content: space-between !important;
    white-space: nowrap !important;
    font-weight: 600 !important;
  }

  /* ---------- WATERMARK (CENTER + SLIGHT UP) ---------- */
  .logo_ap_main{
    position: absolute !important;
    top: 44% !important;              /* move UP (try 42%–46%) */
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 1 !important;
    opacity: 0.12 !important;
    pointer-events: none !important;
    display: block !important;
  }
  .logo_ap_main img{
    width: 380px !important;
    height: auto !important;
    display: block !important;
  }

  /* ---------- QR TOP-RIGHT ---------- */
  .qr-image-ap{
    position: absolute !important;
    top: 12mm !important;
    right: 15mm !important;
    width: 34mm !important;
    height: 34mm !important;
    object-fit: contain !important;
    z-index: 5 !important;
  }

  /* ---------- SMALL LOGO TOP-LEFT ---------- */
  .logo_ap{
    position: absolute !important;
    top: 12mm !important;
    left: 15mm !important;
    z-index: 5 !important;
  }
  .logo_ap img{
    width: 26mm !important;
    height: auto !important;
    display: block !important;
  }

  /* ---------- HEADER CENTER (NO OVERLAP) ---------- */
  .ap-header{
    position: absolute !important;
    top: 13mm !important;
    left: 0 !important;
    right: 0 !important;
    text-align: center !important;
    z-index: 5 !important;
    line-height: 1.35 !important;
  }
  .ap-header h3{
    margin: 0 0 2px 0 !important;
    font-size: 16px !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    text-decoration: underline !important;
  }
  .ap-header p{
    margin: 0 !important;
    font-size: 13.5px !important;
    font-weight: 700 !important;
  }

  /* Push content down below logo/title/QR */
  .content{
    position: relative !important;
    z-index: 6 !important;
    margin-top: 48mm !important;      /* increase if still touching header */
  }

  /* DETAILS TABLE: bold like Daman */
  table.rj.ap.mt{
    width: 100% !important;
    border-collapse: collapse !important;
    font-size: 13.5px !important;
  }
  table.rj.ap.mt td{
    padding: 4px 4px !important;
    vertical-align: top !important;
  }
  table.rj.ap.mt td:nth-child(1),
  table.rj.ap.mt td:nth-child(3){
    font-weight: 800 !important;
    white-space: nowrap !important;
  }
  table.rj.ap.mt td:nth-child(2),
  table.rj.ap.mt td:nth-child(4){
    font-weight: 900 !important;
    word-break: break-word !important;
  }

  /* remove link suffix */
  @media print{
    a[href]:after{ content:"" !important; }
  }
</style>


  </head>

  <body>
    <div class="page">
      <div class="main">
        <!-- BACKGROUND VEHICLE / DATE (FULL RECEIPT AREA) -->
        <div class="bg-repeat">
          <% for (let i = 0; i < 18; i++) { %>
            <p>
              <span><%= data.vehicleNo %> / <%= data.paymentDate %></span>
              <span><%= data.vehicleNo %> / <%= data.paymentDate %></span>
            </p>
          <% } %>
        </div>

        <!-- WATERMARK -->
        <img
          src="<%= data.host %>/images1/andra.png"
          class="watermark"
          alt="Watermark"
        />

        <div class="content">
          <!-- HEADER -->
          <div class="header">
            <div class="header-cell header-logo">
              <img src="<%= data.host %>/images1/andra.png" alt="Logo" />
            </div>

            <div class="header-cell header-center">
              <div class="gov">GOVERNMENT OF ANDHRA PRADESH</div>
              <div class="dept">Department of Transport</div>
              <div class="title">Checkpost Tax e-Receipt</div>
            </div>

            <div class="header-cell header-qr">
              <% if (data.src) { %>
                <img src="<%= data.src %>" alt="QR" />
              <% } %>
            </div>
          </div>

          <!-- DETAILS (YOUR EXISTING TABLE, UNCHANGED DATA) -->
          <table class="rj ap mt">
            <tr class="r1 r11">
              <td class="r1-1">Registration No.</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.vehicleNo%></td>
              <td class="r1-1">Receipt No.</td>
              <td class="r1-2">&nbsp;&nbsp;: APR<%=data.receiptNo%></td>
            </tr>

            <tr class="r1 r14">
              <td class="r1-3">Payment Date</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentDate%></td>
              <td class="r1-1">Owner Name</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.ownerName%></td>
            </tr>

            <tr class="r1 r15">
              <td class="r1-1">Chassis No.</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
              <td class="r1-3">Tax Mode</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.taxMode%></td>
            </tr>

            <tr class="r1">
              <td class="r1-1">Vehicle Type</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.vehiclePermitType%></td>
              <td class="r1-3">Vehicle Class</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleClass%></td>
            </tr>

            <tr class="r1 r14">
              <td class="r1-3-ap">Vehicle Category</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleCategory%></td>
              <td class="r1-3">Mobile No.</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.mobileNo%></td>
            </tr>

            <% if(data.vehiclePermitType!=='TRANSPORT' ){ %>
              <tr class="r1">
                <td class="r1-1">Checkpost Name</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.checkpostName%></td>
                <td class="r1-3">Laden Weight</td>
                <td class="r1-4">&nbsp;&nbsp;: <%=data.grossVehicleWeight%> Kg</td>
              </tr>
            <% } else { %>
              <tr class="r1">
                <td class="r1-1">Checkpost Name</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.checkpostName%></td>
                <td class="r1-3-ap">Seating Capacity</td>
                <td class="r1-4">&nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%></td>
              </tr>
            <% } %>

            <% if(data.vehiclePermitType!=='TRANSPORT' ){ %>
              <tr class="r1">
                <td class="r1-1">Un Laden Weight</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.unladenWeight%> kg</td>
                <td class="r1-3">Bank Ref. No.</td>
                <td class="r1-4">&nbsp;&nbsp;: <%=data.apBankRefNo%></td>
              </tr>
            <% } else { %>
              <tr class="r1">
                <td class="r1-1">Sleeper Cap</td>
                <td class="r1-2">&nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%></td>
                <td class="r1-3">Bank Ref. No.</td>
                <td class="r1-4">&nbsp;&nbsp;: <%=data.apBankRefNo%></td>
              </tr>
            <% } %>

            <tr class="r1">
              <td class="r1-3">Payment Mode</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentMode%></td>
              <td class="r1-1">Permit Validity</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.permitUpto%></td>
            </tr>

            <tr class="r1">
              <td class="r1-3">Fitness Validity</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.fitnessValidity%></td>
              <td class="r1-1">Insurance Validity</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.insuranceValidity%></td>
            </tr>

            <tr class="r1">
              <td class="r1-3">PUCC Validity</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.puccValidity%></td>
              <td class="r1-1">Service Type</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.serviceType%></td>
            </tr>

            <tr class="r1">
              <td class="r1-1">Permit Type</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.permitType%></td>
              <td class="r1-3">Permit Category</td>
              <td class="r1-4">&nbsp;&nbsp;: <%=data.permitCategory%></td>
            </tr>

            <tr class="r1">
              <% if (data.vehicleClass==="GOODS CARRIERS" ){ %>
                <td class="r1-3">Name of Goods</td>
                <td class="r1-4">&nbsp;&nbsp;: <%=data.goodsName%></td>
              <% } %>
              <td class="r1-1">Route</td>
              <td class="r1-2">&nbsp;&nbsp;: <%=data.routeOfTheJourney%></td>
            </tr>
          </table>

          <!-- TAX -->
          <div class="content__money_ap">
            <div class="content__money-r-ap header-row">
              <div class="m1-ap">Tax/Fee Particular</div>
              <div class="m2-ap">Tax/Fees</div>
              <div class="m3-ap">Fine</div>
              <div class="m4-ap">Total</div>
            </div>

            <% if (data.vehiclePermitType==="NON-TRANSPORT" ){ %>
              <div class="content__money-r-ap">
                <div class="m1-ap">MV Tax ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.mvTax%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.mvTax%></div>
              </div>
              <div class="content__money-r-ap">
                <div class="m1-ap">Service/User Charge ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.userCharge%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.userCharge%></div>
              </div>
              <div class="content__money-r-ap">
                <div class="m1-ap">Tax Token Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.surChargeFee%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.surChargeFee%></div>
              </div>
            <% } else { %>
              <div class="content__money-r-ap">
                <div class="m1-ap">Permit Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.permitFee%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.permitFee%></div>
              </div>
              <div class="content__money-r-ap">
                <div class="m1-ap">MV Tax ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.mvTax%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.mvTax%></div>
              </div>
              <div class="content__money-r-ap">
                <div class="m1-ap">Service/User Charge ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.userCharge%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.userCharge%></div>
              </div>
              <div class="content__money-r-ap">
                <div class="m1-ap">Tax Token Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )</div>
                <div class="m2-ap"><%=data.surChargeFee%></div>
                <div class="m3-ap">0</div>
                <div class="m4-ap"><%=data.surChargeFee%></div>
              </div>
            <% } %>
          </div>

          <div class="content__grand content__grand--hr">
            <p style="text-transform:capitalize !important; margin-bottom: 6px;">
              <b>Grand Total :</b> <b><%=data.totalAmount%>/- <%=data.totalAmountInWordLowerCase%></b>
            </p>

            <p style="margin-bottom: 4px;"><b>Note :</b></p>
            <p style="margin-bottom: 4px;"><b>Terms and Conditions:</b></p>

            <div style="margin-left: 16px;">
              <p style="margin: 0 0 4px 0;"><i>1) This is a computer generated printout and no signature is required.</i></p>
              <p style="margin: 0 0 4px 0;"><i>2) Should not carry unlawful/unaccompanied goods.</i></p>
              <p style="margin: 0 0 4px 0;">
                <i>
                  3) If any false information/discrepancies are found at later, necessary action will be taken
                  against the vehicle owner/driver.
                </i>
              </p>
            </div>

            <p class="main__warning" style="font-size: 14px; line-height: 20px; margin-top: 10px;">
              Scan the QR code for genuinity of the receipt, It should land at
              <a style="color: #0b57d0; text-decoration: underline; font-weight: 900;">https://kms.parivahan.gov.in</a>
              site. In case the URL is different, then receipt could be a fake one, please raise a complain.
            </p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
