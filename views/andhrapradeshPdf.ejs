<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,400;1,500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="<%=data.host%>/css/style.css" />
  <% if(data.cssFix){ %>
    <link rel="stylesheet" href="<%=data.host%>/css/cssFix.css" />
  <% } %>

  <style>
    /* FORCE FULL-PAGE WIDTH FOR PDF */
    @page {
      size: A4;
      margin: 0; /* no auto header/footer space */
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Roboto', sans-serif;
    }

    /* Make the content fill entire printable width */
    .main {
      position: relative;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 20px 25px 40px 25px; /* adjust as needed */
      box-sizing: border-box;
    }

    /* QR CODE – TOP RIGHT */
    .qr-image-ap {
      position: absolute;
      top: 20px;
      right: 35px;
      width: 135px;
      height: 135px;
      object-fit: contain;
      z-index: 10;
    }

    /* TOP-LEFT SMALL LOGO */
    .logo_ap {
      position: absolute;
      top: 20px;
      left: 40px;
      z-index: 10;
    }

    .logo_ap img {
      width: 115px;
      height: auto;
      display: block;
    }

    /* BIG WATERMARK – EXACT CENTER */
    .logo_ap_main {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.13;
      z-index: 0;
      pointer-events: none;
    }

    .logo_ap_main img {
      width: 320px;
      height: auto;
    }

    /* BACKGROUND TEXT (VEHICLE / DATE) */
    .content__back {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 0;
      opacity: 0.07;
      pointer-events: none;
      font-size: 11px;
    }

    .content__back p {
      margin: 0;
      line-height: 1.4;
      white-space: nowrap;
    }

    /* TITLE BLOCK – CENTER TOP BETWEEN LOGO AND QR */
    .ap-header {
      position: absolute;
      top: 35px;
      left: 0;
      right: 0;
      text-align: center;
      z-index: 5;
    }

    .ap-header h3 {
      margin: 0 0 2px 0;
      font-size: 16px;
    }

    .ap-header p {
      margin: 0;
      font-size: 13px;
    }

    /* MAIN CONTENT BELOW HEADER */
    .content {
      position: relative;
      z-index: 5;
      margin-top: 115px; /* space for logo + QR + 3-line title */
    }

    table.rj.ap.mt {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-top: 10px;
    }

    table.rj.ap.mt td {
      padding: 2px 4px;
    }

    /* MONEY TABLE */
    .content__money_ap {
      margin-top: 14px;
      font-size: 12px;
    }

    .content__money-r-ap {
      display: flex;
      width: 100%;
      border-bottom: 1px solid #000;
      padding: 4px 0;
    }

    .content__money-r-ap:last-child {
      border-bottom: none;
    }

    .m1-ap {
      width: 55%;
    }

    .m2-ap,
    .m3-ap,
    .m4-ap {
      width: 15%;
      text-align: center;
    }

    .content__grand {
      margin-top: 18px;
      font-size: 12px;
    }

    .content__grand p {
      margin: 2px 0;
    }

    /* PRINT SETTINGS: remove URL suffix on links */
    @media print {
      a[href]:after {
        content: "" !important;
      }
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>

<body>
  <div class="main">
    <!-- QR top-right -->
    <img class="qr-image-ap" src="<%= data.src %>" alt="" />

    <!-- WATERMARK (CENTER) -->
    <div class="main__printing logo_ap_main">
      <img src="<%=data.host%>/images1/andra.png" alt="" />
    </div>

    <!-- SMALL LOGO TOP-LEFT -->
    <div class="logo_ap">
      <img src="<%=data.host%>/images1/andra.png" alt="" />
    </div>

    <!-- 3-LINE TITLE CENTER TOP -->
    <div class="ap-header">
      <h3 class="content__heading content__heading_ap">GOVERMENT OF ANDHRA PRADESH</h3>
      <p class="content__title content__heading_kat">Department of Transport</p>
      <p class="content__desc">Checkpost Tax e-Receipt</p>
    </div>

    <!-- BACKGROUND TEXT (VEHICLE / DATE) -->
    <div class="content__back">
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
      <p>
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span> &nbsp;
        <span><%=data.vehicleNo%> / <%=data.paymentDate%>,</span>
      </p>
    </div>

    <!-- MAIN CONTENT -->
    <div class="content">
      <table class="rj ap mt">
        <tr class="r1 r11">
          <td class="r1-1">Registration No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.vehicleNo%></td>
          <td class="r1-1">Receipt No.</td>
          <td class="r1-2">&nbsp;&nbsp;: APR<%=data.receiptNo%></td>
        </tr>

        <tr class="r1 r14">
          <td class="r1-3">Payment Date</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentDate%></td>
          <td class="r1-1">Owner Name</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.ownerName%></td>
        </tr>
        <tr class="r1 r15">
          <td class="r1-1">Chassis No.</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.chassisNo%></td>
          <td class="r1-3">Tax Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.taxMode%></td>
        </tr>
        <tr class="r1">
          <td class="r1-1">Vehicle Type</td>
          <td class="r1-2"> &nbsp;&nbsp;: <%=data.vehiclePermitType%></td>
          <td class="r1-3">Vehicle Class</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleClass%></td>
        </tr>
        <tr class="r1 r14">
          <td class="r1-3-ap">Vehicle Category</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.vehicleCategory%></td>
          <td class="r1-3">Mobile No.</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.mobileNo%></td>
        </tr>

        <% if(data.vehiclePermitType!=='TRANSPORT' ){ %>
          <tr class="r1">
            <td class="r1-1">Checkpost Name</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.checkpostName%></td>
            <td class="r1-3">Laden Weight</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.grossVehicleWeight%> Kg</td>
          </tr>
        <% } else { %>
          <tr class="r1">
            <td class="r1-1">Checkpost Name</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.checkpostName%></td>
            <td class="r1-3-ap">Seating Capacity</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.seatingCapacityExcludingDriver%></td>
          </tr>
        <% } %>

        <% if(data.vehiclePermitType!=='TRANSPORT' ){ %>
          <tr class="r1">
            <td class="r1-1">Un Laden Weight</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.unladenWeight%> kg</td>
            <td class="r1-3">Bank Ref. No.</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.apBankRefNo%></td>
          </tr>
        <% } else { %>
          <tr class="r1">
            <td class="r1-1">Sleeper Cap</td>
            <td class="r1-2">&nbsp;&nbsp;: <%=data.sleeperCapacityExcludingDriver%></td>
            <td class="r1-3">Bank Ref. No.</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.apBankRefNo%></td>
          </tr>
        <% } %>

        <tr class="r1">
          <td class="r1-3">Payment Mode</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.paymentMode%></td>
          <td class="r1-1">Permit Validity</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.permitUpto%></td>
        </tr>
        <tr class="r1">
          <td class="r1-3">Fitness Validity</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.fitnessValidity%></td>
          <td class="r1-1">Insurance Validity</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.insuranceValidity%></td>
        </tr>
        <tr class="r1">
          <td class="r1-3">PUCC Validity</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.puccValidity%></td>
          <td class="r1-1">Service Type</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.serviceType%></td>
        </tr>

        <tr class="r1">
          <td class="r1-1">Permit Type</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.permitType%></td>
          <td class="r1-3">Permit Category</td>
          <td class="r1-4">&nbsp;&nbsp;: <%=data.permitCategory%></td>
        </tr>
        <tr class="r1">
          <% if (data.vehicleClass==="GOODS CARRIERS" ){ %>
            <td class="r1-3">Name of Goods</td>
            <td class="r1-4">&nbsp;&nbsp;: <%=data.goodsName%></td>
          <% } %>
          <td class="r1-1">Route</td>
          <td class="r1-2">&nbsp;&nbsp;: <%=data.routeOfTheJourney%></td>
        </tr>
      </table>

      <div class="content__money_ap">
        <div class="content__money-r-ap content__money-r2-border d-flex" style="font-size: 13px; text-align: center;">
          <div class="m1-ap"><b>Tax/Fee Particular</b></div>
          <div class="m2-ap"><b>Tax/Fees</b></div>
          <div class="m3-ap"><b>Fine</b></div>
          <div class="m4-ap"><b>Total</b></div>
        </div>

        <% if (data.vehiclePermitType==="NON-TRANSPORT" ){ %>
          <div class="content__money-r-ap content__money-r2-border d-flex">
            <div class="m1-ap">
              MV Tax ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.mvTax%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.mvTax%></div>
          </div>
          <div class="content__money-r-ap content__money-r2-border d-flex">
            <div class="m1-ap">
              Service/User Charge ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.userCharge%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.userCharge%></div>
          </div>
          <div class="content__money-r-ap d-flex">
            <div class="m1-ap">
              Tax Token Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.surChargeFee%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.surChargeFee%></div>
          </div>
        <% } else { %>
          <div class="content__money-r-ap content__money-r2-border d-flex">
            <div class="m1-ap">
              Permit Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.permitFee%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.permitFee%></div>
          </div>
          <div class="content__money-r-ap content__money-r2-border d-flex">
            <div class="m1-ap">
              MV Tax ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.mvTax%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.mvTax%></div>
          </div>
          <div class="content__money-r-ap content__money-r2-border d-flex">
            <div class="m1-ap">
              Service/User Charge ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.userCharge%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.userCharge%></div>
          </div>
          <div class="content__money-r-ap d-flex">
            <div class="m1-ap">
              Tax Token Fee ( <%=data.taxFrom_raj%> to <%=data.taxTo_raj%> )
            </div>
            <div class="m2-ap"><%=data.surChargeFee%></div>
            <div class="m3-ap">0</div>
            <div class="m4-ap"><%=data.surChargeFee%></div>
          </div>
        <% } %>
      </div>

      <div class="content__grand content__grand--hr">
        <p style="text-transform:capitalize !important; margin-bottom: 4px;">
          <span><b>Grand Total :</b></span>
          <b> <%=data.totalAmount%>/- <%=data.totalAmountInWordLowerCase%></b>
        </p>
        <p style="text-transform:capitalize !important; margin-bottom: 4px;">
          <span><b>Note :</b></span>
        </p>
        <p style="margin-bottom: 4px;">
          <span><b>Terms and Conditions:</b></span>
        </p>
        <p style="margin-left: 16px !important;">
          <i>1) This is a computer generated printout and no signature is required.</i>
        </p>
        <p style="margin-left: 16px !important;">
          <i>2) Should not carry unlawful/unaccompanied goods.</i>
        </p>
        <p style="margin-left: 16px !important;">
          <i>
            3) If any false information/discrepancies are found at later, necessary action will be taken<br>
            against the vehicle owner/driver.
          </i>
        </p>
        <br />
        <br />
        <p class="main__warning" style="font-size: 14px; line-height: 20px; margin-top: -10px;">
          Scan the QR code for genuinity of the receipt, It should land at
          <a style="color: blue;">https://kms.privahan.gov.in</a> site. In case the URL is different, then receipt could
          be a fake one, please raise a complain.
        </p>
      </div>
    </div>
  </div>
</body>

</html>
